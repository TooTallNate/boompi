# BlueZ pairing/link-key store lives on /data so paired phones survive
# an OS reflash. Bind-mounted over the default path - bluetoothd itself
# needs no configuration.
[Unit]
Description=Persistent BlueZ state (bind /data/bluetooth)
RequiresMountsFor=/data
After=systemd-tmpfiles-setup.service
Before=bluetooth.service

[Mount]
What=/data/bluetooth
Where=/var/lib/bluetooth
Type=none
Options=bind

[Install]
WantedBy=local-fs.target
