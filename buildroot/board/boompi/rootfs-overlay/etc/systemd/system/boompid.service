[Unit]
Description=Boompi backend daemon
After=pipewire.service wireplumber.service bluetooth.service obexd.service network.target systemd-tmpfiles-setup.service
RequiresMountsFor=/data

[Service]
Type=simple
# Runtime config lives on /data (survives reflashes); the image-baked
# /etc file only seeds the very first boot (hardware facts: model,
# battery bus). Streaming credential caches land in /data/cache.
ExecStart=/usr/bin/boompid --config /data/boompi.toml --config-seed /etc/boompi/boompi.toml
Environment=PIPEWIRE_RUNTIME_DIR=/run/pipewire
Environment=XDG_RUNTIME_DIR=/run/pipewire
Environment=XDG_CACHE_HOME=/data/cache
# Cover art: zbus Connection::session() resolves to the private obexd
# bus (see obex-bus.service / obexd.service).
Environment=DBUS_SESSION_BUS_ADDRESS=unix:path=/run/obex-bus
Environment=RUST_LOG=boompid=info
Restart=always
RestartSec=2
# The AirPlay FIFO bridge blocks in open() on the blocking pool and can't
# be cancelled, so a clean stop stalls; don't let restarts hang for the
# default 90s (this delayed a deploy long enough to muddy bench testing).
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
