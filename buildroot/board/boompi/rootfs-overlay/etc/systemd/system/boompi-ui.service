[Unit]
Description=Boompi touchscreen UI (Slint on DRM/KMS)
After=boompid.service systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/boompi-ui
# Box profile environment (e.g. SLINT_KMS_ROTATION for a
# portrait-native panel mounted landscape). Optional; survives OS
# updates on /data. The Pi 3 image's rotation drop-in still exists
# for boxes provisioned before the profile did.
EnvironmentFile=-/data/box/env
Environment=XDG_CACHE_HOME=/var/cache/boompi
CacheDirectory=boompi
Environment=HOME=/root
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
