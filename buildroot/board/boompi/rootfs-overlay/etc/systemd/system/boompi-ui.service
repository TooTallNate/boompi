[Unit]
Description=Boompi touchscreen UI (Slint on DRM/KMS)
After=boompid.service systemd-udevd.service

[Service]
Type=simple
ExecStart=/usr/bin/boompi-ui
# Panel rotation is board-specific: the Pi 3 overlay adds a drop-in
# with SLINT_KMS_ROTATION for its portrait-native HyperPixel.
Environment=XDG_CACHE_HOME=/var/cache/boompi
CacheDirectory=boompi
Environment=HOME=/root
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
