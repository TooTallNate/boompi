#!/bin/sh
# A/B slot commit / rollback - runs once per boot.
#
# boompi-trial-boot firmware-boots the candidate slot (one-shot
# PM_RSTS partition request on Pi 3, autoboot flipped to the candidate
# on Pi 4 - see its header); the trial's record is the marker on
# persistent /data. On the boot after, three cases:
#
#   running the candidate, healthy -> point autoboot.txt at it (a
#                                     no-op on the Pi 4, the commit on
#                                     the Pi 3) and clear the marker
#   running the candidate, sick    -> point autoboot.txt at the OLD
#                                     slot (rollback; a no-op on the
#                                     Pi 3, where it never moved),
#                                     clear the marker, reboot
#   running the old slot           -> the trial crashed/hung and a
#                                     reset/power-cycle fell back
#                                     (Pi 3 only); just clear the
#                                     marker
set -eu

MARKER=/data/boompi-trial

if [ ! -f "$MARKER" ]; then
    echo "no trial in progress; nothing to commit"
    exit 0
fi

TARGET_ROOT="$(cat "$MARKER")"

case "$TARGET_ROOT" in
    /dev/mmcblk0p3) BOOT_PART=1; OLD_PART=2 ;;
    /dev/mmcblk0p5) BOOT_PART=2; OLD_PART=1 ;;
    *) echo "bogus trial marker '$TARGET_ROOT'; clearing" >&2
       rm -f "$MARKER"; sync; exit 1 ;;
esac

# autoboot.txt always lives on p1, whichever slot is active.
write_autoboot() { # <partition>
    MNT=$(mktemp -d)
    mount /dev/mmcblk0p1 "$MNT"
    printf '[all]\nboot_partition=%s\n' "$1" > "$MNT/autoboot.txt"
    umount "$MNT"
    rmdir "$MNT"
}

case "$(cat /proc/cmdline)" in
    *"root=$TARGET_ROOT "*|*"root=$TARGET_ROOT") ;;
    *)
        rm -f "$MARKER"; sync
        echo "trial of $TARGET_ROOT failed (running old slot); marker cleared" >&2
        exit 0 ;;
esac

# Health gate: boompid must come up and answer before we commit.
echo "trial boot of $TARGET_ROOT detected; waiting for system health"
HEALTHY=0
for i in $(seq 1 60); do
    if wget -q -T 2 -O /dev/null http://127.0.0.1:3001/healthz 2>/dev/null; then
        HEALTHY=1
        break
    fi
    sleep 2
done

if [ "$HEALTHY" = 0 ]; then
    # Roll back: point autoboot at the old slot (a no-op on the Pi 3,
    # where it never moved off it) and reboot into it.
    write_autoboot "$OLD_PART"
    rm -f "$MARKER"; sync
    echo "candidate never became healthy; rolling back to boot_partition=$OLD_PART" >&2
    systemctl reboot
    exit 1
fi

# Commit: the candidate becomes the default (the flip on the Pi 3, a
# no-op on the Pi 4, where trial-boot already pointed autoboot here).
write_autoboot "$BOOT_PART"
rm -f "$MARKER"
sync
echo "committed: boot_partition=$BOOT_PART"
