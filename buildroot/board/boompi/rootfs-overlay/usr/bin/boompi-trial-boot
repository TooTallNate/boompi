#!/bin/sh
# Arm a one-shot trial boot of an already-staged candidate slot and
# reboot into it. The staging (writing rootfs + boot images, sha
# verify) is done by the caller: boompi-update-slot for bundle-dir
# updates, boompid's built-in updater for GitHub release OTAs.
#
# Usage: boompi-trial-boot <candidate-root-dev>
#   candidate-root-dev: /dev/mmcblk0p3 (slot A) or /dev/mmcblk0p5 (B)
#
# Trial mechanism per board:
#
#   Pi 3: one-shot PM_RSTS partition request, consumed by bootcode.bin.
#         autoboot.txt keeps pointing at the RUNNING slot, so a crash,
#         hang or power-cycle during the trial falls back to it;
#         boompi-boot-commit flips the default once the candidate
#         proves healthy.
#
#   Pi 4: autoboot.txt is flipped to the candidate BEFORE the reboot.
#         There is no one-shot mechanism on this board: rev <= 1.3
#         power-cycles the PMIC on every reboot, wiping PM_RSTS and
#         the firmware tryboot flag (both bench-falsified on rev 1.2),
#         and kexec into a kernel build other than the running one
#         hangs after "Bye!" on BOTH boards (pi4 confirmed during the
#         v2.0.0 rollout; kexec is retired). boompi-boot-commit rolls
#         autoboot back if the candidate boots but is sick. A candidate
#         that cannot boot at all leaves the box on the broken slot
#         (recovery: edit autoboot.txt on the SD card) - accepted
#         because slots are sha256-verified before arming and both
#         boards ship the same userspace.
set -eu

TARGET_ROOT="${1:?usage: boompi-trial-boot <candidate-root-dev>}"
MARKER=/data/boompi-trial

case "$TARGET_ROOT" in
    /dev/mmcblk0p3) TARGET_BOOT=/dev/mmcblk0p1; CANDIDATE_PART=1; CURRENT_PART=2 ;;
    /dev/mmcblk0p5) TARGET_BOOT=/dev/mmcblk0p2; CANDIDATE_PART=2; CURRENT_PART=1 ;;
    *) echo "bogus candidate root '$TARGET_ROOT'" >&2; exit 1 ;;
esac

case "$(cat /proc/cmdline)" in
    *"root=$TARGET_ROOT "*|*"root=$TARGET_ROOT")
        echo "$TARGET_ROOT is the RUNNING slot; refusing" >&2; exit 1 ;;
esac

if [ -f "$MARKER" ]; then
    echo "trial of $(cat "$MARKER") still pending (marker present)" >&2
    exit 1
fi

write_autoboot() { # <partition>
    MNT=$(mktemp -d)
    mount /dev/mmcblk0p1 "$MNT"
    printf '[all]\nboot_partition=%s\n' "$1" > "$MNT/autoboot.txt"
    umount "$MNT"
    rmdir "$MNT"
}

case "$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)" in
*"Raspberry Pi 3"*)
    # A freshly written boot-a image carries the image-default
    # autoboot.txt (boot_partition=1, i.e. the candidate); the running
    # slot must stay the default until boompi-boot-commit flips it.
    if [ "$TARGET_BOOT" = /dev/mmcblk0p1 ]; then
        write_autoboot "$CURRENT_PART"
    fi
    # One-shot partition request: the partition number is spread into
    # PM_RSTS bits 0,2,4,6,8,10 with the 0x5a password in the top
    # byte; bootcode.bin consumes and clears the request, so the boot
    # after this one follows autoboot.txt again.
    #
    # Arming depends on the kernel era (bench-proven both ways on the
    # TF-A removal trial):
    # - TF-A kernels (PSCI): the restart handler never runs; BL31's
    #   reset preserves a pre-written PM_RSTS -> devmem arms it.
    # - Stock kernels (spin-table): the bcm2835 restart handler
    #   REWRITES PM_RSTS on reboot (clobbering devmem) but parses the
    #   reboot syscall argument into the partition bits -> the
    #   --reboot-argument arms it.
    # Do both; each era honors one and ignores the other.
    if [ "$TARGET_BOOT" = /dev/mmcblk0p1 ]; then PART=1; RSTS=0x5a000001; else PART=2; RSTS=0x5a000004; fi
    echo "$TARGET_ROOT" > "$MARKER"
    sync
    echo "one-shot firmware boot of candidate ($TARGET_ROOT)"
    devmem 0x3f100020 32 "$RSTS"
    systemctl reboot --reboot-argument="$PART" || reboot
    ;;
*)
    # Commit-with-rollback: the candidate becomes the default now;
    # boompi-boot-commit reverts autoboot.txt if it boots sick.
    write_autoboot "$CANDIDATE_PART"
    echo "$TARGET_ROOT" > "$MARKER"
    sync
    echo "firmware boot of candidate ($TARGET_ROOT); commit rolls back if sick"
    reboot
    ;;
esac
