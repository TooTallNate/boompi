#!/bin/sh
# Write an OS update into the inactive A/B slot and trial-boot it.
#
# Usage: boompi-update-slot <bundle-dir>
#   where <bundle-dir> contains: rootfs.ext4, boot-a.vfat, boot-b.vfat
#   (the CI update bundle, decompressed).
#
# The trial mechanism differs per board; both leave autoboot.txt
# UNTOUCHED so a crash, hang or power-cycle boots the old slot, and
# boompi-boot-commit makes the candidate permanent only after the
# system proves healthy. /data (p6) is never touched.
#
#   Pi 3: one-shot PM_RSTS partition request (the pre-tryboot
#         `reboot N` protocol). bootcode.bin boots the requested
#         partition once and clears the request, giving a full
#         firmware boot of the candidate (all 4 CPUs). Firmware
#         tryboot proper is unusable here: the mailbox tryboot flag
#         is stored in PM_RSTS bit 1, which does not survive the
#         watchdog reset on BCM2837 (verified empirically); and
#         cross-kernel kexec hangs on this board.
#
#   Pi 4: kexec chain-load of the candidate kernel. Pi 4B boards
#         before rev 1.4 power-cycle on every reboot (firmware
#         GPIO-expander reset), which wipes PM_RSTS and the mailbox
#         reboot flags; the firmware only persists the tryboot flag
#         to EEPROM on rev 1.0/1.1, so on rev 1.2/1.3 boards no
#         firmware-level one-shot request survives (see also
#         raspberrypi/firmware#2038).
set -eu

BUNDLE="${1:?usage: boompi-update-slot <bundle-dir>}"
MARKER=/data/boompi-trial

for f in rootfs.ext4 boot-a.vfat boot-b.vfat; do
    [ -f "$BUNDLE/$f" ] || { echo "missing $BUNDLE/$f" >&2; exit 1; }
done

# Never overwrite the fallback slot while a trial is still uncommitted:
# if we are *running* the trial right now, the "inactive" slot is the
# only known-good system we have.
if [ -f "$MARKER" ]; then
    echo "trial of $(cat "$MARKER") still pending (marker present);" \
         "commit or reboot first" >&2
    exit 1
fi

# Active slot from the kernel cmdline (p3 = slot A, p5 = slot B).
case "$(cat /proc/cmdline)" in
    *root=/dev/mmcblk0p3*) ACTIVE=A ;;
    *root=/dev/mmcblk0p5*) ACTIVE=B ;;
    *) echo "cannot determine active slot from cmdline" >&2; exit 1 ;;
esac

if [ "$ACTIVE" = A ]; then
    TARGET_BOOT=/dev/mmcblk0p2; TARGET_ROOT=/dev/mmcblk0p5
    BOOT_IMG="$BUNDLE/boot-b.vfat"; CURRENT_PART=1
else
    TARGET_BOOT=/dev/mmcblk0p1; TARGET_ROOT=/dev/mmcblk0p3
    BOOT_IMG="$BUNDLE/boot-a.vfat"; CURRENT_PART=2
fi

echo "active slot: $ACTIVE - writing update to $TARGET_ROOT / $TARGET_BOOT"
dd if="$BUNDLE/rootfs.ext4" of="$TARGET_ROOT" bs=4M conv=fsync status=none
dd if="$BOOT_IMG" of="$TARGET_BOOT" bs=4M conv=fsync status=none

# Verify the writes end-to-end before daring to boot them.
# (wc -c, not stat: the image's busybox doesn't include stat.)
verify() { # <source-file> <block-dev>
    want=$(sha256sum "$1" | cut -d' ' -f1)
    got=$(head -c "$(wc -c < "$1")" "$2" | sha256sum | cut -d' ' -f1)
    [ "$want" = "$got" ] || { echo "verify FAILED: $2 != $1" >&2; exit 1; }
}
verify "$BUNDLE/rootfs.ext4" "$TARGET_ROOT"
verify "$BOOT_IMG" "$TARGET_BOOT"
echo "slot verified (sha256)"

# Writing boot-a.vfat to p1 replaced autoboot.txt with the image default
# (boot_partition=1, i.e. the *candidate*) - restore the truth: the
# current slot stays the default until boompi-boot-commit flips it.
if [ "$TARGET_BOOT" = /dev/mmcblk0p1 ]; then
    MNT=$(mktemp -d)
    mount /dev/mmcblk0p1 "$MNT"
    printf '[all]\nboot_partition=%s\n' "$CURRENT_PART" > "$MNT/autoboot.txt"
    umount "$MNT"
    rmdir "$MNT"
fi

# Pi 3: arm the one-shot partition request and take a normal reboot.
# The partition number is spread into PM_RSTS bits 0,2,4,6,8,10 with
# the 0x5a password in the top byte; bootcode.bin consumes and clears
# the request, so the boot after this one follows autoboot.txt again.
case "$(tr -d '\0' < /proc/device-tree/model 2>/dev/null || true)" in
*"Raspberry Pi 3"*)
    if [ "$TARGET_BOOT" = /dev/mmcblk0p1 ]; then RSTS=0x5a000001; else RSTS=0x5a000004; fi
    echo "$TARGET_ROOT" > "$MARKER"
    sync
    echo "update staged + verified; one-shot firmware boot of candidate ($TARGET_ROOT)"
    devmem 0x3f100020 32 "$RSTS"
    reboot
    exit 0
    ;;
esac

# Chain-load the candidate: its kernel, the running (firmware-fixed-up)
# device tree, and the current cmdline with the root device swapped -
# the firmware-injected parameters (video=, vc_mem, MAC, ...) are
# hardware-static, so reusing them matches what a real boot would get.
MNT=$(mktemp -d)
mount -o ro "$TARGET_BOOT" "$MNT"
cp "$MNT/Image" /tmp/boompi-trial-Image
umount "$MNT"
rmdir "$MNT"

CMDLINE="$(sed "s|root=/dev/mmcblk0p[0-9]*|root=$TARGET_ROOT|" /proc/cmdline)"
kexec -l /tmp/boompi-trial-Image \
      --dtb=/sys/firmware/fdt \
      --command-line="$CMDLINE"

# Only now that the candidate kernel is loaded do we record the trial:
# tells boompi-boot-commit on the next boot that a candidate is under
# trial, and which slot it is. (Marker after kexec -l, so a failed load
# leaves no stale trial state behind.)
echo "$TARGET_ROOT" > "$MARKER"
sync

echo "update staged + verified; kexec'ing into candidate ($TARGET_ROOT)"
systemctl kexec
