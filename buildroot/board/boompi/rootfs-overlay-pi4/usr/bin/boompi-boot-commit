#!/bin/sh
# A/B slot commit / rollback - runs once per boot.
#
# boompi-update-slot kexec-chains into the candidate slot WITHOUT
# touching autoboot.txt; the only record of the trial is the marker on
# persistent /data. On the boot after, three cases:
#
#   running the candidate, healthy -> rewrite autoboot.txt (commit)
#   running the candidate, sick    -> clear marker + reboot; the
#                                     power-cycle reset boots the old
#                                     slot (autoboot.txt never changed)
#   running the old slot           -> the trial crashed/hung and a
#                                     reset/power-cycle fell back; just
#                                     clear the marker
#
# Residual risk (accepted): the kexec trial exercises kernel + rootfs +
# userspace but not the candidate's config.txt/firmware files; gross
# corruption there is covered by boompi-update-slot's sha256 verify and
# the bootloader's failover-to-partition-1 for unbootable partitions.
set -eu

MARKER=/data/boompi-trial

if [ ! -f "$MARKER" ]; then
    echo "no trial in progress; nothing to commit"
    exit 0
fi

TARGET_ROOT="$(cat "$MARKER")"

case "$TARGET_ROOT" in
    /dev/mmcblk0p3) BOOT_PART=1 ;;
    /dev/mmcblk0p5) BOOT_PART=2 ;;
    *) echo "bogus trial marker '$TARGET_ROOT'; clearing" >&2
       rm -f "$MARKER"; sync; exit 1 ;;
esac

case "$(cat /proc/cmdline)" in
    *"root=$TARGET_ROOT "*|*"root=$TARGET_ROOT") ;;
    *)
        rm -f "$MARKER"; sync
        echo "trial of $TARGET_ROOT failed (running old slot); marker cleared" >&2
        exit 0 ;;
esac

# Health gate: boompid must come up and answer before we commit.
echo "trial boot of $TARGET_ROOT detected; waiting for system health"
HEALTHY=0
for i in $(seq 1 60); do
    if wget -q -T 2 -O /dev/null http://127.0.0.1:3001/healthz 2>/dev/null; then
        HEALTHY=1
        break
    fi
    sleep 2
done

if [ "$HEALTHY" = 0 ]; then
    rm -f "$MARKER"; sync
    echo "candidate never became healthy; rebooting to previous slot" >&2
    systemctl reboot
    exit 1
fi

# Commit: the candidate becomes the default. autoboot.txt always lives
# on p1, whichever slot is active.
MNT=$(mktemp -d)
mount /dev/mmcblk0p1 "$MNT"
printf '[all]\nboot_partition=%s\n' "$BOOT_PART" > "$MNT/autoboot.txt"
umount "$MNT"
rmdir "$MNT"
rm -f "$MARKER"
sync
echo "committed: boot_partition=$BOOT_PART; rebooting onto a firmware boot"

# The kexec trial environment is not quite a real boot (e.g. a CPU can
# fail to come back online across the PSCI off/on cycle) - finish the
# update with a firmware boot of the now-committed slot. The marker is
# gone, so this run's successor is a no-op.
systemctl reboot
