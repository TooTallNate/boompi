# Commits (or rolls back) an A/B update trial — see
# /usr/bin/boompi-boot-commit. No-op on normal boots.
[Unit]
Description=Commit or roll back A/B update trial boot
After=multi-user.target boompid.service data.mount
RequiresMountsFor=/data

[Service]
Type=oneshot
ExecStart=/usr/bin/boompi-boot-commit
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
