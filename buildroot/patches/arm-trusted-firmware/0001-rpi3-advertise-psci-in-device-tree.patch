@@ -28,7 +28,7 @@
 #endif
 
 #ifdef RPI3_PRELOADED_DTB_BASE
-#define MAP_NS_DTB	MAP_REGION_FLAT(RPI3_PRELOADED_DTB_BASE, 0x10000, \
+#define MAP_NS_DTB	MAP_REGION_FLAT(RPI3_PRELOADED_DTB_BASE, 0x100000, \
 					MT_MEMORY | MT_RW | MT_NS)
 #endif
 
