  * Add information to the device tree (if any) about the reserved DRAM used by
  * the Trusted Firmware.
  */
+/*
+ * Advertise PSCI in the device tree (psci node + cpu enable-methods),
+ * like the rpi4 port does. Without this the kernel keeps using the
+ * spin-table enable method and CPUs can never be parked, which breaks
+ * kexec among other things.
+ */
+static void rpi3_dtb_add_psci(void)
+{
+	void *dtb = (void *)RPI3_PRELOADED_DTB_BASE;
+	int ret;
+
+	if (fdt_check_header(dtb) != 0)
+		return;
+
+	/* Grow the in-place tree so the new nodes fit. */
+	ret = fdt_open_into(dtb, dtb, 0x100000);
+	if (ret < 0) {
+		ERROR("rpi3: Invalid Device Tree at %p: error %d\n", dtb, ret);
+		return;
+	}
+
+	if (dt_add_psci_node(dtb)) {
+		ERROR("rpi3: Failed to add PSCI Device Tree node\n");
+		return;
+	}
+
+	if (dt_add_psci_cpu_enable_methods(dtb)) {
+		ERROR("rpi3: Failed to add PSCI cpu enable methods in Device Tree\n");
+		return;
+	}
+
+	INFO("rpi3: PSCI Device Tree nodes added\n");
+}
+
 static void rpi3_dtb_add_mem_rsv(void)
 {
 	int i, regions, rc;
@@ -221,6 +256,7 @@
 {
 #ifdef RPI3_PRELOADED_DTB_BASE
 	/* Only modify a DTB if we know where to look for it */
+	rpi3_dtb_add_psci();
 	rpi3_dtb_add_mem_rsv();
 #endif
 }
