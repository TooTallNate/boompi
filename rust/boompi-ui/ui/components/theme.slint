// Shared colors/sizes for the Boompi UI.

export global Theme {
    out property <color> bg: #0b0b10;
    out property <color> panel: #12121c;
    out property <color> fg: white;
    out property <color> dim: #9999aa;
    out property <color> dimmer: #666677;
    out property <color> faint: #333344;
    out property <color> accent: #00d4ff;
    out property <color> accent2: #ff2d95;
    out property <color> bar: #1c1c30;
    out property <color> good: #55bb66;
    out property <color> bad: #bb5555;
    out property <length> footer-height: 44px;
}
