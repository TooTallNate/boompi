// Settings screen: touch-appropriate controls on the left (theme, art
// fallback, pairing incl. passkey confirm), and a QR code to the web
// settings UI on the right for keyboard-heavy configuration (name, Wi-Fi).

import { Switch } from "std-widgets.slint";
import { ActionButton } from "widgets.slint";
import { Theme } from "theme.slint";
import { IconBack } from "icons.slint";

component Row inherits Rectangle {
    in property <string> label;
    in property <string> sublabel;
    background: Theme.panel;
    border-radius: 8px;
    height: 64px;
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        VerticalLayout {
            alignment: center;
            spacing: 2px;
            Text {
                text: root.label;
                color: Theme.fg;
                font-size: 17px;
            }
            if root.sublabel != "": Text {
                text: root.sublabel;
                color: Theme.dimmer;
                font-size: 13px;
            }
        }
        Rectangle { }
        // Center fixed-height controls (buttons, toggles) vertically in
        // the row instead of letting the layout pin them to the top.
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}

export component SettingsPanel inherits Rectangle {
    in property <string> speaker-name;
    in property <string> version-line;
    in-out property <bool> online-art;
    in property <string> pairing-state; // "idle" | "discoverable" | "confirm"
    in property <string> settings-url;
    in property <image> settings-qr;
    callback close();
    callback online-art-toggled(bool);
    callback theme-toggled(bool);
    callback pairing-enable();
    callback pairing-cancel();

    background: Theme.bg;

    VerticalLayout {
        padding: 14px;
        padding-bottom: Theme.footer-height + 8px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            TouchArea {
                width: 44px;
                clicked => {
                    root.close();
                }
                IconBack {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 22px;
                    icon-color: Theme.dim;
                }
            }
            Text {
                text: "Settings";
                font-size: 22px;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Rectangle { }
        }

        HorizontalLayout {
            spacing: 12px;

            // ---- left column: touch controls -------------------------------
            VerticalLayout {
                spacing: 10px;

                Row {
                    label: "Light theme";
                    sublabel: "Also switchable from the web settings";
                    Switch {
                        checked: Theme.light;
                        toggled => {
                            root.theme-toggled(self.checked);
                        }
                    }
                }

                Row {
                    label: "Fetch album art online";
                    sublabel: "When a source sends no artwork (needs Wi-Fi)";
                    Switch {
                        checked <=> root.online-art;
                        toggled => {
                            root.online-art-toggled(self.checked);
                        }
                    }
                }

                Row {
                    label: "Bluetooth pairing";
                    sublabel: root.pairing-state == "discoverable"
                        ? "Discoverable - check your phone's Bluetooth list"
                        : root.pairing-state == "unavailable"
                        ? "Bluetooth unavailable - is the dongle plugged in?"
                        : "Allow a new device to pair";
                    ActionButton {
                        text: root.pairing-state == "idle" || root.pairing-state == "unavailable"
                            ? "Pair device" : "Cancel";
                        clicked => {
                            if (root.pairing-state == "idle" || root.pairing-state == "unavailable") {
                                root.pairing-enable();
                            } else {
                                root.pairing-cancel();
                            }
                        }
                    }
                }

                Rectangle { } // spacer
            }

            // ---- right column: web settings QR ------------------------------
            if root.settings-url != "": Rectangle {
                width: 220px;
                background: Theme.panel;
                border-radius: 8px;
                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;
                    alignment: start;
                    Text {
                        text: "More settings";
                        color: Theme.fg;
                        font-size: 17px;
                        horizontal-alignment: center;
                    }
                    Text {
                        text: "Name, Wi-Fi, clock, devices -\nscan with your phone:";
                        color: Theme.dimmer;
                        font-size: 13px;
                        horizontal-alignment: center;
                    }
                    Rectangle {
                        height: 150px;
                        Rectangle {
                            x: (parent.width - self.width) / 2;
                            width: 150px;
                            height: 150px;
                            background: white;
                            border-radius: 6px;
                            Image {
                                x: 5px;
                                y: 5px;
                                width: 140px;
                                height: 140px;
                                source: root.settings-qr;
                                image-rendering: pixelated;
                            }
                        }
                    }
                    Text {
                        text: root.settings-url;
                        color: Theme.dim;
                        font-size: 14px;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                }
            }
        }

        Text {
            text: root.version-line;
            color: Theme.faint;
            font-size: 13px;
            horizontal-alignment: center;
        }
    }
}
