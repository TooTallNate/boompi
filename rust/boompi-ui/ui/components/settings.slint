// Settings screen: touch-appropriate controls (theme, text size, art
// fallback, pairing incl. passkey confirm) and a QR code to the web
// settings UI for keyboard-heavy configuration (name, Wi-Fi).
//
// Everything lives in one Flickable column: at larger UI scales the
// logical canvas shrinks (800×480 at 2.0× is 400×240), so the layout
// must scroll by touch rather than fit.

import { Switch } from "std-widgets.slint";
import { ActionButton } from "widgets.slint";
import { Theme } from "theme.slint";
import { IconBack, IconAirplayGeneric, IconAirplayHomePodMini, IconAirplayHomePod, IconAirplayAppleTV, IconSun, IconNote, IconWifi, IconBluetooth, IconDownload } from "icons.slint";

// One emoji font row (built in net.rs from EmojiFontsState).
// status: "active" | "installed" | "missing" | "downloading" | "busy"
export struct EmojiFontRow {
    id: string,
    label: string,
    status: string,
    detail: string,
}

component Row inherits Rectangle {
    in property <string> label;
    in property <string> sublabel;
    background: Theme.panel;
    border-radius: 0.44rem;
    height: content.preferred-height + 1.2rem;
    content := HorizontalLayout {
        padding-left: 0.78rem;
        padding-right: 0.78rem;
        spacing: 0.56rem;
        VerticalLayout {
            alignment: center;
            spacing: 0.11rem;
            Text {
                text: root.label;
                color: Theme.fg;
                font-size: 0.94rem;
                wrap: word-wrap;
            }
            if root.sublabel != "": Text {
                text: root.sublabel;
                color: Theme.dimmer;
                font-size: 0.72rem;
                wrap: word-wrap;
            }
        }
        Rectangle { }
        // Center fixed-height controls (buttons, toggles) vertically in
        // the row instead of letting the layout pin them to the top.
        VerticalLayout {
            alignment: center;
            @children
        }
    }
}


// One icon-only tab in the settings rail (the panel is too small for
// labels; the icons match the web sidebar's grouping).
component RailTab inherits Rectangle {
    in property <bool> active;
    callback tapped();
    // Sized by the parent so the rail can shrink to fit short panels
    // (HyperPixel at large text scales).
    in property <length> size: 2.44rem;
    height: self.size;
    border-radius: min(self.width, self.height) * 0.18;
    background: root.active ? Theme.bar : transparent;
    border-width: root.active ? 0.09rem : 0;
    border-color: Theme.accent;
    @children
    TouchArea {
        clicked => {
            root.tapped();
        }
    }
}

export component SettingsPanel inherits Rectangle {
    in property <string> speaker-name;
    in property <string> version-line;
    in property <string> pairing-state; // "idle" | "discoverable" | "confirm"
    in property <string> settings-url;
    in property <image> settings-qr;
    in property <[EmojiFontRow]> emoji-fonts: [];
    // Advertised AirPlay model ("" = generic); mirrors the web picker.
    in property <string> airplay-model;
    callback airplay-model-tapped(string);
    // Idle screensaver kind ("off"/"clock"/"matrix"/"art").
    in property <string> saver-kind;
    callback saver-kind-tapped(string);
    callback saver-preview-tapped();
    in-out property <bool> clock-24h;
    callback clock-24h-toggled(bool);
    // Software update flow (built in net.rs from UpdateState).
    // status: "idle" | "checking" | "available" | "applying" | "error"
    in property <string> update-version;
    in property <string> update-status: "idle";
    in property <string> update-detail;
    in-out property <bool> update-channel-edge;
    // Wi-Fi card (rejoin saved networks, disconnect, hotspot toggle).
    // Joining NEW networks (password entry) stays on the web UI.
    in property <bool> wifi-supported;
    in property <string> wifi-connected; // SSID, "" = not connected
    in property <string> wifi-ip;
    in-out property <bool> wifi-ap-active;
    in property <string> wifi-ap-ssid;
    in property <[string]> wifi-saved: [];
    callback wifi-rejoin(string);
    callback wifi-disconnect();
    callback wifi-ap-toggled(bool);
    callback emoji-font-tapped(string, string); // (id, status)
    callback update-check();
    callback update-apply();
    callback update-channel-toggled(bool);
    callback close();
    callback theme-toggled(bool);
    callback scale-changed(float);
    callback pairing-enable();
    callback pairing-cancel();

    // Active rail tab: appearance | media | wifi | bluetooth | software.
    in-out property <string> tab: "appearance";

    // The rail must never outgrow the content area (at 150% scale the
    // HyperPixel's logical height is ~320px and five full-size tabs
    // would run past the footer): shrink tabs to fit the available
    // height, capped at the comfortable touch size.
    property <int> rail-count: root.wifi-supported ? 5 : 4;
    // Solve n*size + (n-1)*spacing = height with spacing = 0.18*size:
    // tabs and their gaps shrink together, so the rail fits exactly at
    // any scale. The floor only engages at extreme scales, where a rem
    // is huge in physical pixels - touch targets stay usable.
    property <length> rail-tab-size: max(0.67rem, min(2.44rem,
        railbox.height / (root.rail-count + 0.18 * (root.rail-count - 1))));

    background: Theme.bg;

    VerticalLayout {
        padding: 0.78rem;
        padding-bottom: Theme.footer-height-rem * 1rem + 0.44rem;
        spacing: 0.56rem;

        HorizontalLayout {
            spacing: 0.44rem;
            TouchArea {
                width: 2.44rem;
                clicked => {
                    root.close();
                }
                IconBack {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.11rem;
                    height: 1.22rem;
                    icon-color: Theme.dim;
                }
            }
            Text {
                text: "Settings";
                font-size: 1.22rem;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Rectangle { }
        }
        HorizontalLayout {
            spacing: 0.56rem;

            // Icon rail: settings split into focused tabs instead of one
            // endless scroll - same grouping as the web sidebar.
            railbox := Rectangle {
                width: 2.44rem;
                VerticalLayout {
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                    spacing: root.rail-tab-size * 0.18;
                    alignment: start;
                    RailTab {
                    size: root.rail-tab-size;
                    active: root.tab == "appearance";
                    tapped => {
                        root.tab = "appearance";
                    }
                    IconSun {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.rail-tab-size * 0.55;
                        height: root.rail-tab-size * 0.55;
                        icon-color: root.tab == "appearance" ? Theme.accent : Theme.dim;
                    }
                }
                RailTab {
                    size: root.rail-tab-size;
                    active: root.tab == "media";
                    tapped => {
                        root.tab = "media";
                    }
                    IconNote {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.rail-tab-size * 0.55;
                        height: root.rail-tab-size * 0.55;
                        icon-color: root.tab == "media" ? Theme.accent : Theme.dim;
                    }
                }
                if root.wifi-supported: RailTab {
                    size: root.rail-tab-size;
                    active: root.tab == "wifi";
                    tapped => {
                        root.tab = "wifi";
                    }
                    IconWifi {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.rail-tab-size * 0.55;
                        height: root.rail-tab-size * 0.55;
                        icon-color: root.tab == "wifi" ? Theme.accent : Theme.dim;
                    }
                }
                RailTab {
                    size: root.rail-tab-size;
                    active: root.tab == "bluetooth";
                    tapped => {
                        root.tab = "bluetooth";
                    }
                    IconBluetooth {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.rail-tab-size * 0.55;
                        height: root.rail-tab-size * 0.55;
                        icon-color: root.tab == "bluetooth" ? Theme.accent : Theme.dim;
                    }
                }
                RailTab {
                    size: root.rail-tab-size;
                    active: root.tab == "software";
                    tapped => {
                        root.tab = "software";
                    }
                    IconDownload {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: root.rail-tab-size * 0.55;
                        height: root.rail-tab-size * 0.55;
                        icon-color: root.tab == "software" ? Theme.accent : Theme.dim;
                    }
                }
                }
            }

            Flickable {
                VerticalLayout {
                    spacing: 0.56rem;
                    alignment: start;

                    if root.tab == "appearance": VerticalLayout {
                        spacing: 0.56rem;
                Row {
                    label: "Light theme";
                    sublabel: "Also switchable from the web settings";
                    Switch {
                        checked: Theme.light;
                        toggled => {
                            root.theme-toggled(self.checked);
                        }
                    }
                }

                Row {
                    label: "Text size";
                    sublabel: round(Theme.scale * 100) + "% - resizes the whole panel";
                    HorizontalLayout {
                        spacing: 0.44rem;
                        ActionButton {
                            text: "−";
                            clicked => {
                                root.scale-changed(max(1.0, Theme.scale - 0.25));
                            }
                        }
                        ActionButton {
                            text: "+";
                            clicked => {
                                root.scale-changed(min(2.5, Theme.scale + 0.25));
                            }
                        }
                    }
                }

                Row {
                    label: "24-hour clock";
                    sublabel: "Footer and screensaver time format";
                    Switch {
                        checked <=> root.clock-24h;
                        toggled => {
                            root.clock-24h-toggled(self.checked);
                        }
                    }
                }

                // ---- screensaver ------------------------------------------
                Rectangle {
                    background: Theme.panel;
                    border-radius: 0.44rem;
                    height: saver-col.preferred-height;
                    saver-col := VerticalLayout {
                        padding: 0.78rem;
                        spacing: 0.5rem;
                        HorizontalLayout {
                            spacing: 0.56rem;
                            VerticalLayout {
                                alignment: center;
                                spacing: 0.11rem;
                                Text {
                                    text: "Screensaver";
                                    color: Theme.fg;
                                    font-size: 0.94rem;
                                }
                                Text {
                                    text: "Starts after idle; protects the panel from burn-in";
                                    color: Theme.dimmer;
                                    font-size: 0.72rem;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { }
                            if root.saver-kind != "off": VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    text: "Preview";
                                    clicked => {
                                        root.saver-preview-tapped();
                                    }
                                }
                            }
                        }
                        HorizontalLayout {
                            spacing: 0.44rem;
                            for m[i] in [
                                { label: "Off", value: "off" },
                                { label: "Clock", value: "clock" },
                                { label: "Matrix", value: "matrix" },
                                { label: "Album art", value: "art" },
                            ]: Rectangle {
                                border-radius: 0.33rem;
                                border-width: 0.09rem;
                                border-color: root.saver-kind == m.value ? Theme.accent : Theme.faint;
                                background: root.saver-kind == m.value ? Theme.bar : transparent;
                                height: saver-tile.preferred-height;
                                saver-tile := VerticalLayout {
                                    padding: 0.44rem;
                                    Text {
                                        text: m.label;
                                        color: root.saver-kind == m.value ? Theme.fg : Theme.dim;
                                        font-size: 0.72rem;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.saver-kind-tapped(m.value);
                                    }
                                }
                            }
                        }
                    }
                }
                    }

                    if root.tab == "media": VerticalLayout {
                        spacing: 0.56rem;
                // One card for the whole catalog: separate rows read as
                // unrelated settings, and this mirrors the web's list.
                Rectangle {
                    background: Theme.panel;
                    border-radius: 0.44rem;
                    height: emoji-col.preferred-height;
                    emoji-col := VerticalLayout {
                        padding: 0.78rem;
                        spacing: 0.5rem;
                        VerticalLayout {
                            spacing: 0.11rem;
                            Text {
                                text: "Emoji style";
                                color: Theme.fg;
                                font-size: 0.94rem;
                            }
                            Text {
                                text: "Selecting briefly restarts this screen";
                                color: Theme.dimmer;
                                font-size: 0.72rem;
                            }
                        }
                        for f[i] in root.emoji-fonts: VerticalLayout {
                            spacing: 0.5rem;
                            Rectangle {
                                height: 0.06rem;
                                background: Theme.faint;
                            }
                            HorizontalLayout {
                                spacing: 0.56rem;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 0.11rem;
                                    Text {
                                        text: f.label;
                                        color: Theme.fg;
                                        font-size: 0.89rem;
                                    }
                                    Text {
                                        text: f.detail;
                                        color: Theme.dimmer;
                                        font-size: 0.72rem;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle { }
                                VerticalLayout {
                                    alignment: center;
                                    if f.status == "active": Text {
                                        text: "Active";
                                        color: Theme.good;
                                        font-size: 0.83rem;
                                    }
                                    if f.status == "installed" || f.status == "missing": ActionButton {
                                        text: f.status == "installed" ? "Use" : "Download";
                                        clicked => {
                                            root.emoji-font-tapped(f.id, f.status);
                                        }
                                    }
                                    if f.status == "downloading": Text {
                                        text: "…";
                                        color: Theme.dim;
                                        font-size: 0.83rem;
                                    }
                                }
                            }
                        }
                    }
                }


                // ---- AirPlay icon -----------------------------------------
                Rectangle {
                    background: Theme.panel;
                    border-radius: 0.44rem;
                    height: airplay-col.preferred-height;
                    airplay-col := VerticalLayout {
                        padding: 0.78rem;
                        spacing: 0.5rem;
                        VerticalLayout {
                            spacing: 0.11rem;
                            Text {
                                text: "AirPlay icon";
                                color: Theme.fg;
                                font-size: 0.94rem;
                            }
                            Text {
                                text: "How the speaker appears in phones' AirPlay lists";
                                color: Theme.dimmer;
                                font-size: 0.72rem;
                                wrap: word-wrap;
                            }
                        }
                        HorizontalLayout {
                            spacing: 0.44rem;
                            for m[i] in [
                                { label: "Generic", value: "" },
                                { label: "Pod mini", value: "AudioAccessory5,1" },
                                { label: "HomePod", value: "AudioAccessory1,1" },
                                { label: "Apple TV", value: "AppleTV14,1" },
                            ]: Rectangle {
                                border-radius: 0.33rem;
                                border-width: 0.09rem;
                                border-color: root.airplay-model == m.value ? Theme.accent : Theme.faint;
                                background: root.airplay-model == m.value ? Theme.bar : transparent;
                                height: tile-col.preferred-height;
                                tile-col := VerticalLayout {
                                    padding: 0.44rem;
                                    spacing: 0.28rem;
                                    Rectangle {
                                        height: 1.9rem;
                                        if m.value == "": IconAirplayGeneric {
                                            icon-color: Theme.fg;
                                            height: parent.height;
                                        }
                                        if m.value == "AudioAccessory5,1": IconAirplayHomePodMini {
                                            icon-color: Theme.fg;
                                            height: parent.height;
                                        }
                                        if m.value == "AudioAccessory1,1": IconAirplayHomePod {
                                            icon-color: Theme.fg;
                                            height: parent.height;
                                        }
                                        if m.value == "AppleTV14,1": IconAirplayAppleTV {
                                            icon-color: Theme.fg;
                                            height: parent.height;
                                        }
                                    }
                                    Text {
                                        text: m.label;
                                        color: root.airplay-model == m.value ? Theme.fg : Theme.dim;
                                        font-size: 0.61rem;
                                        horizontal-alignment: center;
                                    }
                                }
                                TouchArea {
                                    clicked => {
                                        root.airplay-model-tapped(m.value);
                                    }
                                }
                            }
                        }
                    }
                }
                    }

                    if root.tab == "wifi": VerticalLayout {
                        spacing: 0.56rem;
                // ---- Wi-Fi ------------------------------------------------
                // Touch-appropriate subset: rejoin a saved network, drop
                // the current one, and the hotspot toggle. New networks
                // (keyboard for the password) go through the web UI.
                if root.wifi-supported: Rectangle {
                    background: Theme.panel;
                    border-radius: 0.44rem;
                    height: wifi-col.preferred-height;
                    wifi-col := VerticalLayout {
                        padding: 0.78rem;
                        spacing: 0.5rem;
                        HorizontalLayout {
                            spacing: 0.56rem;
                            VerticalLayout {
                                alignment: center;
                                spacing: 0.11rem;
                                Text {
                                    text: "Wi-Fi";
                                    color: Theme.fg;
                                    font-size: 0.94rem;
                                }
                                Text {
                                    text: root.wifi-connected != ""
                                        ? "Connected to “" + root.wifi-connected + "”"
                                            + (root.wifi-ip != "" ? " - " + root.wifi-ip : "")
                                        : root.wifi-ap-active
                                        ? "Hotspot mode - not on a network"
                                        : "Not connected";
                                    color: root.wifi-connected != "" ? Theme.good : Theme.dimmer;
                                    font-size: 0.72rem;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { }
                            if root.wifi-connected != "": VerticalLayout {
                                alignment: center;
                                ActionButton {
                                    text: "Disconnect";
                                    clicked => {
                                        root.wifi-disconnect();
                                    }
                                }
                            }
                        }
                        // Saved networks: tap to rejoin (password kept by
                        // the saved profile).
                        for ssid[i] in root.wifi-saved: VerticalLayout {
                            spacing: 0.5rem;
                            Rectangle {
                                height: 0.06rem;
                                background: Theme.faint;
                            }
                            HorizontalLayout {
                                spacing: 0.56rem;
                                VerticalLayout {
                                    alignment: center;
                                    Text {
                                        text: ssid;
                                        color: Theme.fg;
                                        font-size: 0.89rem;
                                        overflow: elide;
                                    }
                                }
                                Rectangle { }
                                VerticalLayout {
                                    alignment: center;
                                    if ssid == root.wifi-connected: Text {
                                        text: "Connected";
                                        color: Theme.good;
                                        font-size: 0.83rem;
                                    }
                                    if ssid != root.wifi-connected: ActionButton {
                                        text: "Join";
                                        clicked => {
                                            root.wifi-rejoin(ssid);
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle {
                            height: 0.06rem;
                            background: Theme.faint;
                        }
                        // Hotspot: the speaker broadcasts its own network so
                        // a phone can reach the web UI (and control it) with
                        // no shared Wi-Fi - camping mode.
                        HorizontalLayout {
                            spacing: 0.56rem;
                            VerticalLayout {
                                alignment: center;
                                spacing: 0.11rem;
                                Text {
                                    text: "Hotspot";
                                    color: Theme.fg;
                                    font-size: 0.89rem;
                                }
                                Text {
                                    text: root.wifi-ap-active
                                        ? "Broadcasting “" + root.wifi-ap-ssid + "” - join it and scan the QR below"
                                        : "Speaker broadcasts its own network - control it anywhere, no Wi-Fi needed";
                                    color: root.wifi-ap-active ? Theme.good : Theme.dimmer;
                                    font-size: 0.72rem;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked <=> root.wifi-ap-active;
                                    toggled => {
                                        root.wifi-ap-toggled(self.checked);
                                    }
                                }
                            }
                        }
                    }
                }
                    }

                    if root.tab == "bluetooth": VerticalLayout {
                        spacing: 0.56rem;
                Row {
                    label: "Bluetooth pairing";
                    sublabel: root.pairing-state == "discoverable"
                        ? "Discoverable - check your phone's Bluetooth list"
                        : root.pairing-state == "unavailable"
                        ? "Bluetooth unavailable - is the dongle plugged in?"
                        : "Allow a new device to pair";
                    ActionButton {
                        text: root.pairing-state == "idle" || root.pairing-state == "unavailable"
                            ? "Pair device" : "Cancel";
                        clicked => {
                            if (root.pairing-state == "idle" || root.pairing-state == "unavailable") {
                                root.pairing-enable();
                            } else {
                                root.pairing-cancel();
                            }
                        }
                    }
                }
                    }

                    if root.tab == "software": VerticalLayout {
                        spacing: 0.56rem;
                // ---- software update --------------------------------------
                Rectangle {
                    background: Theme.panel;
                    border-radius: 0.44rem;
                    height: update-col.preferred-height;
                    update-col := VerticalLayout {
                        padding: 0.78rem;
                        spacing: 0.5rem;
                        HorizontalLayout {
                            spacing: 0.56rem;
                            VerticalLayout {
                                alignment: center;
                                spacing: 0.11rem;
                                Text {
                                    text: "Software";
                                    color: Theme.fg;
                                    font-size: 0.94rem;
                                }
                                Text {
                                    text: root.update-version;
                                    color: Theme.dimmer;
                                    font-size: 0.72rem;
                                }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                if root.update-status == "idle" || root.update-status == "error": ActionButton {
                                    text: "Check for updates";
                                    clicked => {
                                        root.update-check();
                                    }
                                }
                                if root.update-status == "checking": Text {
                                    text: "Checking…";
                                    color: Theme.dim;
                                    font-size: 0.83rem;
                                }
                                if root.update-status == "available": VerticalLayout {
                                    spacing: 0.33rem;
                                    ActionButton {
                                        text: "Update";
                                        clicked => {
                                            root.update-apply();
                                        }
                                    }
                                    // A newer build may have superseded
                                    // the stored offer (edge moves fast);
                                    // allow re-checking without waiting
                                    // for the periodic pass.
                                    ActionButton {
                                        text: "Re-check";
                                        clicked => {
                                            root.update-check();
                                        }
                                    }
                                }
                            }
                        }
                        // Detail line: the offered version, download
                        // progress, or the error.
                        if root.update-detail != "": Text {
                            text: root.update-detail;
                            color: root.update-status == "error" ? Theme.bad : Theme.dimmer;
                            font-size: 0.72rem;
                            wrap: word-wrap;
                        }
                        Rectangle {
                            height: 0.06rem;
                            background: Theme.faint;
                        }
                        HorizontalLayout {
                            spacing: 0.56rem;
                            VerticalLayout {
                                alignment: center;
                                spacing: 0.11rem;
                                Text {
                                    text: "Bleeding edge updates";
                                    color: Theme.fg;
                                    font-size: 0.89rem;
                                }
                                Text {
                                    text: "Follow every green dev build, not just releases";
                                    color: Theme.dimmer;
                                    font-size: 0.72rem;
                                    wrap: word-wrap;
                                }
                            }
                            Rectangle { }
                            VerticalLayout {
                                alignment: center;
                                Switch {
                                    checked <=> root.update-channel-edge;
                                    toggled => {
                                        root.update-channel-toggled(self.checked);
                                    }
                                }
                            }
                        }
                    }
                }

                // ---- web settings QR --------------------------------------
                if root.settings-url != "": Rectangle {
                    height: qr-card.preferred-height;
                    qr-card := Rectangle {
                        x: (parent.width - self.width) / 2;
                        width: min(parent.width, 13rem);
                        background: Theme.panel;
                        border-radius: 0.44rem;
                        height: qr-col.preferred-height;
                        qr-col := VerticalLayout {
                            padding: 0.89rem;
                            spacing: 0.56rem;
                            alignment: start;
                            Text {
                                text: "More settings";
                                color: Theme.fg;
                                font-size: 0.94rem;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Name, Wi-Fi, clock, devices -\nscan with your phone:";
                                color: Theme.dimmer;
                                font-size: 0.72rem;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                height: 8.33rem;
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    width: 8.33rem;
                                    height: 8.33rem;
                                    background: white;
                                    border-radius: 0.33rem;
                                    Image {
                                        x: 0.28rem;
                                        y: 0.28rem;
                                        width: parent.width - 0.56rem;
                                        height: parent.height - 0.56rem;
                                        source: root.settings-qr;
                                        image-rendering: pixelated;
                                    }
                                }
                            }
                            Text {
                                text: root.settings-url;
                                color: Theme.dim;
                                font-size: 0.78rem;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                Text {
                    text: root.version-line;
                    color: Theme.faint;
                    font-size: 0.72rem;
                    horizontal-alignment: center;
                }
                    }
                }
            }
        }
    }
}
