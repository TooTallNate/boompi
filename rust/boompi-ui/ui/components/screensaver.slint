// Idle screensavers: mostly-black, slowly moving content. Two jobs at
// once - relieve panel burn-in (image retention appeared on both
// boxes after long static idle) and keep GPU load LOW: everything
// here is driven by `tick`, an ~8 fps counter from a Rust timer that
// only runs while the saver is visible. No animation-tick(), no
// continuous 60 fps repaints - a screensaver that hammers the vc4 for
// hours would invite the exact GPU hangs it coexists with.

import { Theme } from "theme.slint";
import { BatteryGlyph } from "widgets.slint";

// One column of Matrix rain, drawn with Rezmason's film-traced glyph
// font (rust/boompi-ui/ui/fonts/Matrix-Code.ttf, MIT - see
// github.com/Rezmason/matrix): mirrored katakana + digits + symbols
// at their real codepoints, so plain Text renders the movie glyphs.
//
// Variety without per-glyph rendering (the GPU budget is 8 fps and a
// few dozen Text elements): each column is TWO stacked half-strings
// selected independently from ten variants - 100 combinations per
// column, reselected on different cadences per half - plus scrambled
// selectors (index² mixing, so neighbors and every-Nth columns don't
// rhyme), one-in-five short trails, and a little x jitter. A bright
// leader glyph rides the falling edge, mutating fast like the film's.
component HalfString inherits Text {
    in property <int> variant;
    color: #00c355;
    font-family: "Matrix-Code";
    font-size: 22px;
    horizontal-alignment: left;
    text: self.variant == 0 ? "モ\nエ\nヤ\nキ\nオ\nカ\n7\nケ\nサ\nス"
        : self.variant == 1 ? "z\n1\n5\n2\nヨ\nタ\nワ\n4\nネ\nヌ"
        : self.variant == 2 ? "ナ\n9\n8\nヒ\n0\nホ\nア\n3\nウ\nセ"
        : self.variant == 3 ? "ミ\nラ\nリ\nツ\nテ\nニ\nハ\nソ\nコ\nシ"
        : self.variant == 4 ? "マ\nム\nメ\n<\nヤ\n8\nエ\nー\n5\nオ"
        : self.variant == 5 ? "ネ\n0\n╌\nキ\nサ\n2\nモ\nテ\n9\nリ"
        : self.variant == 6 ? "ツ\n4\nホ\nz\nミ\n>\nヌ\n1\nカ\nウ"
        : self.variant == 7 ? "7\nア\nタ\n*\nヒ\n5\nマ\nソ\n+\nメ"
        : self.variant == 8 ? "ス\nヨ\n:\n3\nラ\nコ\n0\nセ\nエ\n9"
        : "|\nニ\n8\nワ\nシ\n1\nテ\nム\n2\nナ";
}

component MatrixColumn inherits Rectangle {
    in property <int> index;
    in property <float> tick;
    in property <length> screen-height;
    property <float> speed: 30 + Math.mod(self.index * self.index * 7 + self.index * 37, 61); // px/s
    property <bool> long-trail: Math.mod(self.index * 5 + 3, 5) != 0;
    property <length> len: 22px * (self.long-trail ? 20 : 10) * 1.15;
    property <length> half: 22px * 10 * 1.15;
    property <length> head-y: (Math.mod(self.tick * self.speed + Math.mod(self.index * self.index * 53 + self.index * 173, 700), (self.screen-height + self.len) / 1px) * 1px);
    // Independent mutation clocks per half; index² mixing keeps
    // every-Nth-column patterns from lining up.
    property <int> mut-a: Math.floor(self.tick / 1.3) * 5 + self.index * 7 + Math.mod(self.index * self.index, 13);
    property <int> mut-b: Math.floor(self.tick / 1.9) * 3 + self.index * 11 + Math.mod(self.index * self.index * 3, 17);
    // Base offset from the parent centers the column field on any
    // screen width (hardcoding overflowed 800px panels and underfilled
    // 1024px ones).
    in property <length> x0: 0;
    x: self.x0 + self.index * 34px + (Math.mod(self.index * 17, 7) - 3) * 1px;
    width: 30px;
    height: 100%;

    if root.long-trail: HalfString {
        y: root.head-y - root.len;
        variant: Math.mod(root.mut-a, 10);
    }
    HalfString {
        y: root.head-y - root.half;
        variant: Math.mod(root.mut-b, 10);
    }

    // The bright leader at the falling edge.
    Text {
        y: root.head-y - 26px;
        color: #d4ffd8;
        font-family: "Matrix-Code";
        font-size: 22px;
        horizontal-alignment: left;
        text: Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 0 ? "ハ"
            : Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 1 ? "3"
            : Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 2 ? "セ"
            : Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 3 ? "ワ"
            : Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 4 ? "ネ"
            : Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 5 ? "0"
            : Math.mod(root.mut-a + Math.floor(root.tick * 4), 8) == 6 ? "リ"
            : "タ";
    }
}

export component Screensaver inherits Rectangle {
    in property <string> kind; // "clock" | "matrix" | "art"
    in property <float> tick; // seconds, ~8 fps while visible
    in property <string> clock-h;
    in property <string> clock-m;
    in property <string> clock-ampm;
    in property <string> clock-day;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <string> track-title;
    in property <bool> battery-present;
    in property <float> battery-percentage;
    in property <bool> battery-charging;
    callback dismissed();

    background: black;

    // Rain columns sized to the screen: as many 34px columns as fit.
    property <int> matrix-cols: Math.max(1, Math.floor((self.width - 8px) / 34px));

    // Slow lissajous drift for the static savers: full period is
    // minutes, so content never parks on the same pixels.
    property <float> drift-x: Math.sin(root.tick * 1.9deg);
    property <float> drift-y: Math.cos(root.tick * 1.3deg);

    if root.kind == "matrix": Rectangle {
        for i in root.matrix-cols: MatrixColumn {
            index: i;
            tick: root.tick;
            screen-height: root.height;
            x0: (root.width - root.matrix-cols * 34px) / 2;
        }
    }

    if root.kind == "clock": VerticalLayout {
        x: (root.width - self.preferred-width) * (0.5 + 0.38 * root.drift-x);
        y: (root.height - self.preferred-height) * (0.5 + 0.38 * root.drift-y);
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 0.2rem;
        HorizontalLayout {
            alignment: center;
            spacing: 0.4rem;
            Text {
                text: root.clock-h + ":" + root.clock-m;
                color: #9999aa;
                font-size: root.height * 0.24;
                font-weight: 300;
            }
            if root.clock-ampm != "": Text {
                text: root.clock-ampm;
                color: #555566;
                font-size: root.height * 0.07;
                vertical-alignment: bottom;
            }
        }
        Text {
            text: root.clock-day;
            color: #444455;
            font-size: root.height * 0.06;
            horizontal-alignment: center;
        }
    }

    // Art saver falls back to the clock layout when no art exists.
    if root.kind == "art" && root.has-artwork: VerticalLayout {
        x: (root.width - self.preferred-width) * (0.5 + 0.3 * root.drift-x);
        y: (root.height - self.preferred-height) * (0.5 + 0.3 * root.drift-y);
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 0.5rem;
        Image {
            source: root.artwork;
            width: root.height * 0.42;
            height: root.height * 0.42;
            opacity: 0.75;
        }
        Text {
            text: root.track-title;
            color: #555566;
            font-size: root.height * 0.045;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    if root.kind == "art" && !root.has-artwork: Text {
        x: (root.width - self.width) * (0.5 + 0.38 * root.drift-x);
        y: (root.height - self.height) * (0.5 + 0.38 * root.drift-y);
        text: root.clock-ampm == "" ? root.clock-h + ":" + root.clock-m
            : root.clock-h + ":" + root.clock-m + " " + root.clock-ampm;
        color: #9999aa;
        font-size: root.height * 0.2;
        font-weight: 300;
    }

    // Battery status on every saver (only when the box has telemetry):
    // a glance at the shelf answers "does it need charging?" without
    // waking the panel. Near the bottom, drifting like the rest of the
    // content so it cannot burn in.
    if root.battery-present: HorizontalLayout {
        x: (root.width - self.preferred-width) * (0.5 + 0.3 * root.drift-x);
        y: root.height * 0.88 + root.height * 0.03 * root.drift-y;
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 0.5rem;
        alignment: center;
        BatteryGlyph {
            y: (parent.height - self.height) / 2;
            height: 0.7778rem;
            present: true;
            percentage: root.battery-percentage;
            charging: root.battery-charging;
            dim: #555566;
            faint: #333340;
        }
        Text {
            text: Math.round(root.battery-percentage * 100) + "%";
            color: #555566;
            font-size: 0.7778rem;
            vertical-alignment: center;
        }
    }

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }
}
