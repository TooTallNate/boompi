// Idle screensavers: mostly-black, slowly moving content. Two jobs at
// once - relieve panel burn-in (image retention appeared on both
// boxes after long static idle) and keep GPU load LOW: everything
// here is driven by `tick`, an ~8 fps counter from a Rust timer that
// only runs while the saver is visible. No animation-tick(), no
// continuous 60 fps repaints - a screensaver that hammers the vc4 for
// hours would invite the exact GPU hangs it coexists with.

import { Theme } from "theme.slint";

// One column of Matrix rain, drawn with Rezmason's film-traced glyph
// font (rust/boompi-ui/ui/fonts/Matrix-Code.ttf, MIT - see
// github.com/Rezmason/matrix): mirrored katakana + digits + symbols
// at their real codepoints, so plain Text renders the movie glyphs.
// A falling string wraps around the screen; the whole column swaps
// its glyphs every ~1.5s (staggered per column) which reads as the
// film's in-place glyph mutation, and a brighter leader glyph rides
// the falling edge.
component MatrixColumn inherits Rectangle {
    in property <int> index;
    in property <float> tick;
    in property <length> screen-height;
    property <float> speed: 30 + Math.mod(self.index * 37, 55); // px/s
    property <length> len: 22px * 20 * 1.15;
    property <length> head-y: (Math.mod(self.tick * self.speed + self.index * 173, (self.screen-height + self.len) / 1px) * 1px);
    property <int> mutation: Math.floor(self.tick / 1.5) + self.index * 13;
    x: 6px + self.index * 34px;
    width: 30px;
    height: 100%;

    Text {
        y: root.head-y - root.len;
        color: #00c355;
        font-family: "Matrix-Code";
        font-size: 22px;
        horizontal-alignment: left;
        text: Math.mod(root.mutation, 4) == 0 ? "モ\nエ\nヤ\nキ\nオ\nカ\n7\nケ\nサ\nス\nz\n1\n5\n2\nヨ\nタ\nワ\n4\nネ\nヌ"
            : Math.mod(root.mutation, 4) == 1 ? "ナ\n9\n8\nヒ\n0\nホ\nア\n3\nウ\nセ\nミ\nラ\nリ\nツ\nテ\nニ\nハ\nソ\nコ\nシ"
            : Math.mod(root.mutation, 4) == 2 ? "マ\nム\nメ\n<\nヤ\n8\nエ\nー\n5\nオ\nネ\n0\n╌\nキ\nサ\n2\nモ\nテ\n9\nリ"
            : "ツ\n4\nホ\nz\nミ\n>\nヌ\n1\nカ\nウ\n7\nア\nタ\n*\nヒ\n5\nマ\nソ\n+\nメ";
    }

    // The bright leader at the falling edge, mutating fast like the
    // film's head glyphs.
    Text {
        y: root.head-y - 26px;
        color: #d4ffd8;
        font-family: "Matrix-Code";
        font-size: 22px;
        horizontal-alignment: left;
        text: Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 0 ? "ハ"
            : Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 1 ? "3"
            : Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 2 ? "セ"
            : Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 3 ? "ワ"
            : Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 4 ? "ネ"
            : Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 5 ? "0"
            : Math.mod(root.mutation + Math.floor(root.tick * 4), 8) == 6 ? "リ"
            : "タ";
    }
}

export component Screensaver inherits Rectangle {
    in property <string> kind; // "clock" | "matrix" | "art"
    in property <float> tick; // seconds, ~8 fps while visible
    in property <string> clock-h;
    in property <string> clock-m;
    in property <string> clock-ampm;
    in property <string> clock-day;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <string> track-title;
    callback dismissed();

    background: black;

    // Slow lissajous drift for the static savers: full period is
    // minutes, so content never parks on the same pixels.
    property <float> drift-x: Math.sin(root.tick * 1.9deg);
    property <float> drift-y: Math.cos(root.tick * 1.3deg);

    if root.kind == "matrix": Rectangle {
        for i in 24: MatrixColumn {
            index: i;
            tick: root.tick;
            screen-height: root.height;
        }
    }

    if root.kind == "clock": VerticalLayout {
        x: (root.width - self.preferred-width) * (0.5 + 0.38 * root.drift-x);
        y: (root.height - self.preferred-height) * (0.5 + 0.38 * root.drift-y);
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 0.2rem;
        HorizontalLayout {
            alignment: center;
            spacing: 0.4rem;
            Text {
                text: root.clock-h + ":" + root.clock-m;
                color: #9999aa;
                font-size: root.height * 0.24;
                font-weight: 300;
            }
            if root.clock-ampm != "": Text {
                text: root.clock-ampm;
                color: #555566;
                font-size: root.height * 0.07;
                vertical-alignment: bottom;
            }
        }
        Text {
            text: root.clock-day;
            color: #444455;
            font-size: root.height * 0.06;
            horizontal-alignment: center;
        }
    }

    // Art saver falls back to the clock layout when no art exists.
    if root.kind == "art" && root.has-artwork: VerticalLayout {
        x: (root.width - self.preferred-width) * (0.5 + 0.3 * root.drift-x);
        y: (root.height - self.preferred-height) * (0.5 + 0.3 * root.drift-y);
        width: self.preferred-width;
        height: self.preferred-height;
        spacing: 0.5rem;
        Image {
            source: root.artwork;
            width: root.height * 0.42;
            height: root.height * 0.42;
            opacity: 0.75;
        }
        Text {
            text: root.track-title;
            color: #555566;
            font-size: root.height * 0.045;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    if root.kind == "art" && !root.has-artwork: Text {
        x: (root.width - self.width) * (0.5 + 0.38 * root.drift-x);
        y: (root.height - self.height) * (0.5 + 0.38 * root.drift-y);
        text: root.clock-ampm == "" ? root.clock-h + ":" + root.clock-m
            : root.clock-h + ":" + root.clock-m + " " + root.clock-ampm;
        color: #9999aa;
        font-size: root.height * 0.2;
        font-weight: 300;
    }

    TouchArea {
        clicked => {
            root.dismissed();
        }
    }
}
