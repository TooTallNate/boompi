// Small theme-aware widgets. The std-widgets controls follow the fluent
// palette, not our Theme - fine for Switch (blue accent works on both
// themes), broken for Button (light-on-light label in light mode).

import { Theme } from "theme.slint";

// Volume slider. std-widgets' Slider has fixed internal geometry that
// ignores the rem scale (thumb and track stay tiny at 200%); this one
// is all rem.
export component VSlider inherits Rectangle {
    in-out property <float> value; // 0..1
    callback edited(float);
    height: 2.2rem;

    track := Rectangle {
        y: (parent.height - self.height) / 2;
        height: 0.44rem;
        border-radius: 0.22rem;
        background: Theme.bar;
        Rectangle {
            x: 0;
            width: parent.width * root.value;
            height: parent.height;
            border-radius: parent.border-radius;
            background: Theme.accent;
        }
    }
    thumb := Rectangle {
        width: 1.55rem;
        height: 1.55rem;
        border-radius: self.width / 2;
        background: white;
        x: (parent.width - self.width) * root.value;
        y: (parent.height - self.height) / 2;
        drop-shadow-color: black.transparentize(0.6);
        drop-shadow-blur: 0.33rem;
        drop-shadow-offset-y: 0.08rem;
    }
    ta := TouchArea {
        moved => {
            if (self.pressed) {
                root.value = max(0, min(1, self.mouse-x / root.width));
                root.edited(root.value);
            }
        }
        clicked => {
            root.value = max(0, min(1, self.mouse-x / root.width));
            root.edited(root.value);
        }
    }
}

export component ActionButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary: false;
    callback clicked();

    background: root.primary
        ? Theme.accent
        : (touch.pressed ? Theme.faint : Theme.bar);
    border-radius: 0.4444rem;
    height: 2.2222rem;
    width: label.preferred-width + 2rem;

    label := Text {
        text: root.text;
        color: root.primary ? (Theme.light ? white : #04121f) : Theme.fg;
        font-size: 0.8889rem;
        font-weight: root.primary ? 600 : 400;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        clicked => {
            root.clicked();
        }
    }
}

// Battery glyph drawn from rectangles (no font/SVG dependency), shared
// by the footer and the screensaver overlay. Geometry follows the
// original footer icon: body 2:1 with a nub on the right; the whole
// component is sized by its `height` (total width = 2.214 * height).
// Colors are injectable because the screensaver draws on pure black
// with its own dim palette, not the Theme's.
export component BatteryGlyph {
    in property <bool> present;
    in property <float> percentage; // 0..1
    in property <bool> charging;
    in property <color> dim: Theme.dim;
    in property <color> faint: Theme.faint;
    width: self.height * 2.214;

    Rectangle {
        // body
        x: 0;
        y: 0;
        width: root.height * 2;
        height: root.height;
        border-width: root.height * 0.071;
        border-color: root.present ? root.dim : root.faint;
        border-radius: root.height * 0.214;
        if root.present: Rectangle {
            // fill level
            x: root.height * 0.143;
            y: root.height * 0.143;
            width: (parent.width - root.height * 0.286) * max(0.04, min(1.0, root.percentage));
            height: parent.height - root.height * 0.286;
            border-radius: root.height * 0.143;
            background: root.charging ? Theme.good
                : root.percentage < 0.2 ? Theme.bad
                : root.dim;
        }
    }
    Rectangle {
        // tip (dim regardless of presence, matching the original
        // footer icon)
        x: root.height * 2;
        y: (root.height - root.height * 0.43) / 2;
        width: root.height * 0.214;
        height: root.height * 0.43;
        border-radius: root.height * 0.071;
        background: root.dim;
    }
}
