// Now Playing: album art (placeholder until Phase 3), track metadata
// marquees, position bar, transport controls, volume slider.

import { Theme } from "theme.slint";
import { VSlider } from "widgets.slint";
import { Marquee } from "marquee.slint";
import { TrackPosition } from "track_position.slint";
import { IconPlay, IconPause, IconPrev, IconNext, IconSpeaker, IconNote } from "icons.slint";

component TransportButton inherits Rectangle {
    in property <bool> primary: false;
    in property <bool> enabled: true;
    in property <float> fit: 1.0;
    callback clicked();
    width: (root.primary ? 4.6667rem : 3.6667rem) * root.fit;
    height: self.width;
    border-radius: self.width / 2;
    background: ta.pressed && root.enabled ? #2c2c48 : #1b1b2e;
    border-width: 0.0556rem;
    border-color: #32324e;
    opacity: root.enabled ? 1.0 : 0.35;
    ta := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.clicked();
        }
    }
    @children
}

export component NowPlaying inherits VerticalLayout {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> remaining;
    in-out property <float> volume;
    // False when transport commands cannot reach the sender (AirPlay 2
    // senders run no DACP server) - buttons dim and go inert.
    in property <bool> controls-enabled: true;

    callback toggle-play();
    callback next();
    callback previous();
    callback volume-edited(float);

    alignment: center;
    spacing: 0.8889rem * self.fit;
    padding: 1.4444rem;
    padding-bottom: Theme.footer-height-rem * 1rem + 0.6667rem;

    // At larger UI scales the fixed-size graphics (album art, transport
    // buttons) stop fitting the physical screen; text keeps the user's
    // chosen size while the graphics compress to make room. 1.0 at
    // design scale; the floor keeps buttons comfortably tappable.
    property <float> fit: max(0.45, min(1.0, (self.height - 8rem) / 14.7rem));

    HorizontalLayout {
        spacing: 1.3333rem;

        // Album art (AVRCP cover art via boompid; note icon when absent).
        // The glow needs to live on an outer rectangle: drop shadows and
        // `clip: true` don't combine on one element.
        Rectangle {
            width: 10rem * root.fit;
            height: 10rem * root.fit;
            border-radius: 0.6667rem;
            drop-shadow-color: Theme.accent.transparentize(0.6);
            drop-shadow-blur: 1.5556rem;
            drop-shadow-offset-x: 0;
            drop-shadow-offset-y: 0;
        Rectangle {
            width: 10rem * root.fit;
            height: 10rem * root.fit;
            border-radius: 0.6667rem;
            background: #16161f;
            clip: true;
            if root.has-artwork: Image {
                width: 100%;
                height: 100%;
                source: root.artwork;
                image-fit: cover;
            }
            if !root.has-artwork: IconNote {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 3.5556rem * root.fit;
                height: 3.5556rem * root.fit;
                icon-color: Theme.faint;
            }
        }
        }

        VerticalLayout {
            alignment: center;
            spacing: 0.4444rem;
            Marquee {
                text: root.track-title;
                font-size: 1.6667rem;
                font-weight: 700;
                text-color: Theme.fg;
            }
            Marquee {
                text: root.track-artist;
                font-size: 1.1667rem;
                text-color: #ccccdd;
            }
            Marquee {
                text: root.track-album;
                font-size: 0.9444rem;
                text-color: #8888a0;
            }
            TrackPosition {
                progress: root.progress;
                elapsed: root.elapsed;
                remaining: root.remaining;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 1.5556rem * root.fit;
        TransportButton {
            fit: root.fit;
            enabled: root.controls-enabled;
            clicked => {
                root.previous();
            }
            IconPrev {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40%;
                height: 40%;
                icon-color: Theme.fg;
            }
        }
        TransportButton {
            primary: true;
            fit: root.fit;
            enabled: root.controls-enabled;
            clicked => {
                root.toggle-play();
            }
            if root.playing: IconPause {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40%;
                height: 40%;
                icon-color: Theme.fg;
            }
            if !root.playing: IconPlay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 42%;
                height: 42%;
                icon-color: Theme.fg;
            }
        }
        TransportButton {
            fit: root.fit;
            enabled: root.controls-enabled;
            clicked => {
                root.next();
            }
            IconNext {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40%;
                height: 40%;
                icon-color: Theme.fg;
            }
        }
    }

    if !root.controls-enabled: Text {
        text: "Control playback from the sending device";
        color: Theme.dimmer;
        font-size: 0.72rem;
        horizontal-alignment: center;
    }

    HorizontalLayout {
        alignment: center;
        spacing: 0.7778rem;
        Rectangle {
            width: 1.2222rem;
            IconSpeaker {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1rem;
                height: 1rem;
                icon-color: Theme.dim;
                level: 1;
            }
        }
        VSlider {
            width: min(20rem, root.width - 7rem);
            value <=> root.volume;
            edited(value) => {
                root.volume-edited(value);
            }
        }
        Rectangle {
            width: 1.4444rem;
            IconSpeaker {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.2222rem;
                height: 1.2222rem;
                icon-color: Theme.dim;
                level: 2;
            }
        }
    }
}
