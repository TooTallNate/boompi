// Now Playing: album art (placeholder until Phase 3), track metadata
// marquees, position bar, transport controls, volume slider.

import { Slider } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Marquee } from "marquee.slint";
import { TrackPosition } from "track_position.slint";
import { IconPlay, IconPause, IconPrev, IconNext, IconSpeaker, IconNote } from "icons.slint";

component TransportButton inherits Rectangle {
    in property <bool> primary: false;
    callback clicked();
    width: root.primary ? 84px : 66px;
    height: self.width;
    border-radius: self.width / 2;
    background: ta.pressed ? #2c2c48 : #1b1b2e;
    border-width: 1px;
    border-color: #32324e;
    ta := TouchArea {
        clicked => {
            root.clicked();
        }
    }
    @children
}

export component NowPlaying inherits VerticalLayout {
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <image> artwork;
    in property <bool> has-artwork;
    in property <bool> playing;
    in property <float> progress;
    in property <string> elapsed;
    in property <string> remaining;
    in-out property <float> volume;

    callback toggle-play();
    callback next();
    callback previous();
    callback volume-edited(float);

    alignment: center;
    spacing: 16px;
    padding: 26px;
    padding-bottom: Theme.footer-height + 12px;

    HorizontalLayout {
        spacing: 24px;

        // Album art (AVRCP cover art via boompid; note icon when absent).
        Rectangle {
            width: 180px;
            height: 180px;
            border-radius: 12px;
            background: #16161f;
            clip: true;
            if root.has-artwork: Image {
                width: 100%;
                height: 100%;
                source: root.artwork;
                image-fit: cover;
            }
            if !root.has-artwork: IconNote {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 64px;
                height: 64px;
                icon-color: Theme.faint;
            }
        }

        VerticalLayout {
            alignment: center;
            spacing: 8px;
            Marquee {
                text: root.track-title;
                font-size: 30px;
                font-weight: 700;
                text-color: Theme.fg;
            }
            Marquee {
                text: root.track-artist;
                font-size: 21px;
                text-color: #ccccdd;
            }
            Marquee {
                text: root.track-album;
                font-size: 17px;
                text-color: #8888a0;
            }
            TrackPosition {
                progress: root.progress;
                elapsed: root.elapsed;
                remaining: root.remaining;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 28px;
        TransportButton {
            clicked => {
                root.previous();
            }
            IconPrev {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40%;
                height: 40%;
                icon-color: Theme.fg;
            }
        }
        TransportButton {
            primary: true;
            clicked => {
                root.toggle-play();
            }
            if root.playing: IconPause {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40%;
                height: 40%;
                icon-color: Theme.fg;
            }
            if !root.playing: IconPlay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 42%;
                height: 42%;
                icon-color: Theme.fg;
            }
        }
        TransportButton {
            clicked => {
                root.next();
            }
            IconNext {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 40%;
                height: 40%;
                icon-color: Theme.fg;
            }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 14px;
        Rectangle {
            width: 22px;
            IconSpeaker {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 18px;
                height: 18px;
                icon-color: Theme.dim;
                level: 1;
            }
        }
        Slider {
            width: 360px;
            minimum: 0;
            maximum: 1;
            value <=> root.volume;
            changed(value) => {
                root.volume-edited(value);
            }
        }
        Rectangle {
            width: 26px;
            IconSpeaker {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 22px;
                height: 22px;
                icon-color: Theme.dim;
                level: 2;
            }
        }
    }
}
