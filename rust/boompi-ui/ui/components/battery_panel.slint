// Battery diagnostics: rolling voltage/current chart + live stats.
// Chart data arrives as pre-built SVG path command strings from Rust
// (viewbox 0–100 × 0–100, newest sample at the right edge).

import { Theme } from "theme.slint";
import { IconBack, IconBolt } from "icons.slint";

component Stat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    background: Theme.panel;
    border-radius: 8px;
    height: 62px;
    VerticalLayout {
        alignment: center;
        spacing: 2px;
        Text {
            text: root.value;
            horizontal-alignment: center;
            font-size: 20px;
            color: Theme.fg;
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 12px;
            color: Theme.dimmer;
        }
    }
}

export component BatteryPanel inherits Rectangle {
    in property <string> voltage-path;
    in property <string> current-path;
    in property <string> stat-volts;
    in property <string> stat-amps;
    in property <string> stat-watts;
    in property <string> stat-percent;
    in property <bool> charging;

    callback close();

    background: Theme.bg;

    VerticalLayout {
        padding: 14px;
        padding-bottom: Theme.footer-height + 8px;
        spacing: 10px;

        HorizontalLayout {
            spacing: 8px;
            TouchArea {
                width: 44px;
                clicked => {
                    root.close();
                }
                IconBack {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 20px;
                    height: 22px;
                    icon-color: Theme.dim;
                }
            }
            Text {
                text: "Battery";
                font-size: 22px;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Rectangle { }
            if root.charging: HorizontalLayout {
                spacing: 6px;
                Rectangle {
                    width: 16px;
                    IconBolt {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 14px;
                        height: 18px;
                        icon-color: Theme.good;
                    }
                }
                Text {
                    text: "charging";
                    color: Theme.good;
                    vertical-alignment: center;
                }
            }
        }

        // Chart: voltage (magenta) + current (cyan), 3-minute window.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-radius: 8px;
            clip: true;
            Path {
                viewbox-width: 100;
                viewbox-height: 100;
                commands: root.voltage-path;
                stroke: Theme.accent2;
                stroke-width: 2px;
                fill: transparent;
            }
            Path {
                viewbox-width: 100;
                viewbox-height: 100;
                commands: root.current-path;
                stroke: Theme.accent;
                stroke-width: 2px;
                fill: transparent;
            }
            // Legend
            HorizontalLayout {
                x: 12px;
                y: 8px;
                height: 18px;
                spacing: 14px;
                Text { text: "- volts"; color: Theme.accent2; font-size: 13px; }
                Text { text: "- amps"; color: Theme.accent; font-size: 13px; }
            }
        }

        HorizontalLayout {
            spacing: 8px;
            Stat { value: root.stat-volts; label: "VOLTS"; }
            Stat { value: root.stat-amps; label: "AMPS"; }
            Stat { value: root.stat-watts; label: "WATTS"; }
            Stat { value: root.stat-percent; label: "CHARGE"; }
        }
    }
}
