// Battery diagnostics: rolling voltage/current chart + live stats.
// Chart data arrives as pre-built SVG path command strings from Rust
// (viewbox 0-100 × 0-100, newest sample at the right edge).

import { Theme } from "theme.slint";
import { IconBack, IconBolt } from "icons.slint";

component Stat inherits Rectangle {
    in property <string> value;
    in property <string> label;
    background: Theme.panel;
    border-radius: 0.4444rem;
    height: 3.4444rem;
    VerticalLayout {
        alignment: center;
        spacing: 0.1111rem;
        Text {
            text: root.value;
            horizontal-alignment: center;
            font-size: 1.1111rem;
            color: Theme.fg;
        }
        Text {
            text: root.label;
            horizontal-alignment: center;
            font-size: 0.6667rem;
            color: Theme.dimmer;
        }
    }
}

export component BatteryPanel inherits Rectangle {
    in property <string> voltage-path;
    in property <string> current-path;
    in property <string> stat-volts;
    in property <string> stat-amps;
    in property <string> stat-watts;
    in property <string> stat-percent;
    in property <string> stat-time;
    in property <bool> charging;
    in property <bool> full;

    callback close();

    background: Theme.bg;

    VerticalLayout {
        padding: 0.7778rem;
        padding-bottom: Theme.footer-height-rem * 1rem + 0.4444rem;
        spacing: 0.5556rem;

        HorizontalLayout {
            spacing: 0.4444rem;
            TouchArea {
                width: 2.4444rem;
                clicked => {
                    root.close();
                }
                IconBack {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: 1.1111rem;
                    height: 1.2222rem;
                    icon-color: Theme.dim;
                }
            }
            Text {
                text: "Battery";
                font-size: 1.2222rem;
                color: Theme.fg;
                vertical-alignment: center;
            }
            Rectangle { }
            if root.charging || root.full: HorizontalLayout {
                spacing: 0.3333rem;
                Rectangle {
                    width: 0.8889rem;
                    IconBolt {
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                        width: 0.7778rem;
                        height: 1rem;
                        icon-color: Theme.good;
                    }
                }
                Text {
                    text: root.full ? "full" : "charging";
                    color: Theme.good;
                    vertical-alignment: center;
                }
            }
        }

        // Chart: voltage (magenta) + current (cyan), 3-minute window.
        Rectangle {
            vertical-stretch: 1;
            background: Theme.panel;
            border-radius: 0.4444rem;
            clip: true;
            Path {
                viewbox-width: 100;
                viewbox-height: 100;
                commands: root.voltage-path;
                stroke: Theme.accent2;
                stroke-width: 0.1111rem;
                fill: transparent;
            }
            Path {
                viewbox-width: 100;
                viewbox-height: 100;
                commands: root.current-path;
                stroke: Theme.accent;
                stroke-width: 0.1111rem;
                fill: transparent;
            }
            // Legend
            HorizontalLayout {
                x: 0.6667rem;
                y: 0.4444rem;
                height: 1rem;
                spacing: 0.7778rem;
                Text { text: "- volts"; color: Theme.accent2; font-size: 0.7222rem; }
                Text { text: "- amps"; color: Theme.accent; font-size: 0.7222rem; }
            }
        }

        HorizontalLayout {
            spacing: 0.4444rem;
            Stat { value: root.stat-volts; label: "VOLTS"; }
            Stat { value: root.stat-amps; label: "AMPS"; }
            Stat { value: root.stat-watts; label: "WATTS"; }
            Stat { value: root.stat-percent; label: "CHARGE"; }
            Stat { value: root.stat-time; label: "TIME LEFT"; }
        }
    }
}
