// SVG iconography, tinted at runtime via `Image.colorize` (the SVG's own
// fill is just an alpha mask).
//
// Sources:
//  - ../icons/*.svg from the Geist icon set (geist-icons npm package, MIT -
//    see ../icons/LICENSE-geist-icons.txt), matching Vercel's geistcn icons.
//  - spotify.svg + bluetooth.svg from SVG Repo (CC0 collections).
//
// Slint renders these with resvg at display resolution, so they stay crisp
// at any size. Requires i-slint-core's `svg` feature, which both the winit
// (desktop) and linuxkms (Pi) backends enable in our feature graph.

export component IconPlay inherits Image {
    in property <color> icon-color: white;
    source: @image-url("../icons/play-fill.svg");
    colorize: root.icon-color;
    image-fit: contain;
}

export component IconPause inherits Image {
    in property <color> icon-color: white;
    source: @image-url("../icons/pause.svg");
    colorize: root.icon-color;
    image-fit: contain;
}

export component IconPrev inherits Image {
    in property <color> icon-color: white;
    source: @image-url("../icons/skip-back-fill.svg");
    colorize: root.icon-color;
    image-fit: contain;
}

export component IconNext inherits Image {
    in property <color> icon-color: white;
    source: @image-url("../icons/skip-forward-fill.svg");
    colorize: root.icon-color;
    image-fit: contain;
}

export component IconSpeaker inherits Image {
    in property <color> icon-color: white;
    /// 0 = muted, 1 = quiet, 2 = loud.
    in property <int> level: 2;
    source: root.level == 0 ? @image-url("../icons/speaker-off-fill.svg")
        : root.level == 1 ? @image-url("../icons/speaker-volume-quiet-fill.svg")
        : @image-url("../icons/speaker-volume-loud-fill.svg");
    colorize: root.icon-color;
    image-fit: contain;
}

export component IconSpotify inherits Image {
    in property <color> icon-color: #1DB954;
    source: @image-url("../icons/spotify.svg");
    colorize: root.icon-color;
    image-fit: contain;
}

// Geist "shareplay" glyph: display with a triangle rising through it.
