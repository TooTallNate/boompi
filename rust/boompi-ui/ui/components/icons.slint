// Drawn vector iconography — zero font dependency.
//
// RPi OS Lite and the Buildroot image ship no emoji/symbol fonts, and glyph
// coverage varies by renderer, so all icons are Slint Paths (viewbox
// 100×100, scaled to the element size). Keep icon elements square —
// Path viewbox scaling does not preserve aspect ratio.

export component IconPlay inherits Path {
    in property <color> icon-color: white;
    viewbox-width: 100;
    viewbox-height: 100;
    commands: "M 22 6 L 92 50 L 22 94 Z";
    fill: root.icon-color;
}

export component IconPause inherits Path {
    in property <color> icon-color: white;
    viewbox-width: 100;
    viewbox-height: 100;
    commands: "M 20 10 H 42 V 90 H 20 Z M 58 10 H 80 V 90 H 58 Z";
    fill: root.icon-color;
}

export component IconPrev inherits Path {
    in property <color> icon-color: white;
    viewbox-width: 100;
    viewbox-height: 100;
    commands: "M 12 10 H 26 V 90 H 12 Z M 90 10 L 34 50 L 90 90 Z";
