// Eighth note for the album-art placeholder.
export component IconNote inherits Rectangle {
    in property <color> icon-color: white;
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 60 14 V 74";
        stroke: root.icon-color;
        stroke-width: 7px;
        fill: transparent;
    }
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 60 12 Q 84 18 88 40 Q 76 30 60 32 Z";
        fill: root.icon-color;
    }
    Rectangle {
        x: parent.width * 40% - self.width / 2;
        y: parent.height * 74% - self.height / 2;
        width: parent.width * 30%;
        height: parent.height * 22%;
        border-radius: self.height / 2;
        background: root.icon-color;
    }
}
