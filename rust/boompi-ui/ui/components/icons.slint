}

// Speaker with mute-X (level 0) or 1–2 sound waves.
export component IconSpeaker inherits Rectangle {
    in property <color> icon-color: white;
    /// 0 = muted, 1 = quiet, 2 = loud.
    in property <int> level: 2;

    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 4 35 H 28 L 58 10 V 90 L 28 65 H 4 Z";
        fill: root.icon-color;
    }
    if root.level == 0: Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 68 36 L 94 64 M 94 36 L 68 64";
        stroke: root.icon-color;
        stroke-width: 8px;
        fill: transparent;
    }
    if root.level >= 1: Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 68 36 Q 78 50 68 64";
        stroke: root.icon-color;
        stroke-width: 7px;
        fill: transparent;
    }
    if root.level >= 2: Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 80 24 Q 96 50 80 76";
        stroke: root.icon-color;
        stroke-width: 7px;
        fill: transparent;
    }
}

// Spotify mark: circle ring + three ascending sound-wave arcs.
export component IconSpotify inherits Rectangle {
    in property <color> icon-color: #1DB954;
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 50 6 A 44 44 0 1 0 50 94 A 44 44 0 1 0 50 6";
        stroke: root.icon-color;
        stroke-width: 7px;
        fill: transparent;
    }
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 26 42 Q 52 33 76 46";
        stroke: root.icon-color;
        stroke-width: 8px;
        fill: transparent;
    }
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 29 57 Q 51 49 72 60";
        stroke: root.icon-color;
        stroke-width: 7px;
        fill: transparent;
    }
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 32 71 Q 50 65 68 73";
        stroke: root.icon-color;
        stroke-width: 6px;
        fill: transparent;
    }
}

