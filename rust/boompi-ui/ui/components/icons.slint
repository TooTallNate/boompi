// Settings: three sliders with staggered knobs.
export component IconSliders inherits Rectangle {
    in property <color> icon-color: white;
    Path {
        viewbox-width: 100;
        viewbox-height: 100;
        commands: "M 8 25 H 92 M 8 50 H 92 M 8 75 H 92";
        stroke: root.icon-color;
        stroke-width: 7px;
        fill: transparent;
    }
    Rectangle {
        x: parent.width * 22% - self.width / 2;
        y: parent.height * 25% - self.height / 2;
        width: parent.width * 24%;
        height: self.width;
        border-radius: self.width / 2;
        background: root.icon-color;
    }
    Rectangle {
        x: parent.width * 68% - self.width / 2;
        y: parent.height * 50% - self.height / 2;
        width: parent.width * 24%;
        height: self.width;
        border-radius: self.width / 2;
        background: root.icon-color;
    }
    Rectangle {
        x: parent.width * 40% - self.width / 2;
        y: parent.height * 75% - self.height / 2;
        width: parent.width * 24%;
        height: self.width;
        border-radius: self.width / 2;
        background: root.icon-color;
    }
}

