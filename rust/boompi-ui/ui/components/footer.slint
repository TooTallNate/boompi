// Persistent bottom bar: clock (blinking colon), connected device +
// source indicator, battery icon, settings.
// All iconography is drawn (see icons.slint) - no font dependency.

import { Theme } from "theme.slint";
import { IconBluetooth, IconSettings, IconSpotify, IconAirplay } from "icons.slint";
import { BatteryGlyph } from "widgets.slint";

export component Footer inherits Rectangle {
    in property <string> clock-day;
    in property <string> clock-h;
    in property <string> clock-m;
    in property <string> clock-ampm;
    in property <bool> colon-on: true;
    in property <string> device-name;
    /// "bluetooth" | "spotify" | "airplay" | "" (no active source).
    in property <string> source-kind: "";
    in property <bool> battery-present;
    in property <float> battery-percentage;
    in property <bool> battery-charging;

    callback open-battery();
    callback open-games();
    callback open-settings();

    height: Theme.footer-height-rem * 1rem;
    background: #000000aa;

    HorizontalLayout {
        padding-left: 0.7778rem;
        padding-right: 0.4444rem;
        spacing: 0.7778rem;

        // Clock: "Mon 4:32" with a blinking colon.
        HorizontalLayout {
            spacing: 0;
            Text {
                text: root.clock-day + "  ";
                color: Theme.dimmer;
                vertical-alignment: center;
            }
            Text {
                text: root.clock-h;
                color: Theme.dim;
                vertical-alignment: center;
            }
            Text {
                text: ":";
                color: Theme.dim;
                vertical-alignment: center;
                opacity: root.colon-on ? 1.0 : 0.15;
            }
            Text {
                text: root.clock-m;
                color: Theme.dim;
                vertical-alignment: center;
            }
            if root.clock-ampm != "": Text {
                text: " " + root.clock-ampm;
                color: Theme.dimmer;
                vertical-alignment: center;
            }
        }

        Rectangle { } // spacer

        // Active source logo + name (Spotify username, phone alias, ...).
        if root.source-kind == "bluetooth": Rectangle {
            width: 1.1111rem;
            IconBluetooth {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 0.8889rem;
                height: 1rem;
                icon-color: #0A84FF;
            }
        }
        if root.source-kind == "spotify": Rectangle {
            width: 1.2222rem;
            IconSpotify {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.0556rem;
                height: 1.0556rem;
            }
        }
        if root.source-kind == "airplay": Rectangle {
            width: 1.2222rem;
            IconAirplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.0556rem;
                height: 1.0556rem;
                icon-color: Theme.dim;
            }
        }
        Text {
            text: root.device-name;
            color: Theme.dimmer;
            vertical-alignment: center;
            overflow: elide;
        }

        // Games (the screen explains the empty state; hiding the
        // entry point just buries the feature).
        TouchArea {
            width: 2rem;
            clicked => {
                root.open-games();
            }
            Text {
                text: "🎮";
                font-size: 1.1rem;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: parent.width;
                height: parent.height;
            }
        }

        // Battery icon (tap → diagnostics panel). Always shown: with
        // no telemetry it renders as an empty outline and the panel
        // explains why (unconfigured box profile vs sensor error).
        TouchArea {
            width: 2rem;
            clicked => {
                root.open-battery();
            }
            BatteryGlyph {
                x: 0;
                y: (parent.height - 0.7778rem) / 2;
                height: 0.7778rem;
                present: root.battery-present;
                percentage: root.battery-percentage;
                charging: root.battery-charging;
            }
        }

        TouchArea {
            width: 1.8889rem;
            clicked => {
                root.open-settings();
            }
            IconSettings {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.0556rem;
                height: 1.0556rem;
                icon-color: Theme.dimmer;
            }
        }
    }
}
