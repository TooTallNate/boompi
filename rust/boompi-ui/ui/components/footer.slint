// Persistent bottom bar: clock (blinking colon), connected device +
// source indicator, battery icon, settings.
// All iconography is drawn (see icons.slint) - no font dependency.

import { Theme } from "theme.slint";
import { IconBluetooth, IconSettings, IconSpotify, IconAirplay } from "icons.slint";

export component Footer inherits Rectangle {
    in property <string> clock-day;
    in property <string> clock-h;
    in property <string> clock-m;
    in property <bool> colon-on: true;
    in property <string> device-name;
    /// "bluetooth" | "spotify" | "airplay" | "" (no active source).
    in property <string> source-kind: "";
    in property <bool> battery-present;
    in property <float> battery-percentage;
    in property <bool> battery-charging;

    callback open-battery();
    callback open-settings();

    height: Theme.footer-height-rem * 1rem;
    background: #000000aa;

    HorizontalLayout {
        padding-left: 0.7778rem;
        padding-right: 0.4444rem;
        spacing: 0.7778rem;

        // Clock: "Mon 4:32" with a blinking colon.
        HorizontalLayout {
            spacing: 0;
            Text {
                text: root.clock-day + "  ";
                color: Theme.dimmer;
                vertical-alignment: center;
            }
            Text {
                text: root.clock-h;
                color: Theme.dim;
                vertical-alignment: center;
            }
            Text {
                text: ":";
                color: Theme.dim;
                vertical-alignment: center;
                opacity: root.colon-on ? 1.0 : 0.15;
            }
            Text {
                text: root.clock-m;
                color: Theme.dim;
                vertical-alignment: center;
            }
        }

        Rectangle { } // spacer

        // Active source logo + name (Spotify username, phone alias, ...).
        if root.source-kind == "bluetooth": Rectangle {
            width: 1.1111rem;
            IconBluetooth {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 0.8889rem;
                height: 1rem;
                icon-color: #0A84FF;
            }
        }
        if root.source-kind == "spotify": Rectangle {
            width: 1.2222rem;
            IconSpotify {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.0556rem;
                height: 1.0556rem;
            }
        }
        if root.source-kind == "airplay": Rectangle {
            width: 1.2222rem;
            IconAirplay {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.0556rem;
                height: 1.0556rem;
                icon-color: Theme.dim;
            }
        }
        Text {
            text: root.device-name;
            color: Theme.dimmer;
            vertical-alignment: center;
            overflow: elide;
        }

        // Battery icon (tap → diagnostics panel).
        if root.battery-present: TouchArea {
            width: 2rem;
            clicked => {
                root.open-battery();
            }
            Rectangle {
                // body
                x: 0;
                y: (parent.height - 0.7778rem) / 2;
                width: 1.5556rem;
                height: 0.7778rem;
                border-width: 0.0556rem;
                border-color: Theme.dim;
                border-radius: 0.1667rem;
                Rectangle {
                    // fill level
                    x: 0.1111rem;
                    y: 0.1111rem;
                    width: (parent.width - 0.2222rem) * max(0.04, min(1.0, root.battery-percentage));
                    height: parent.height - 0.2222rem;
                    border-radius: 0.1111rem;
                    background: root.battery-charging ? Theme.good
                        : root.battery-percentage < 0.2 ? Theme.bad
                        : Theme.dim;
                }
            }
            Rectangle {
                // tip
                x: 1.5556rem;
                y: (parent.height - 0.3333rem) / 2;
                width: 0.1667rem;
                height: 0.3333rem;
                border-radius: 0.0556rem;
                background: Theme.dim;
            }
        }

        TouchArea {
            width: 1.8889rem;
            clicked => {
                root.open-settings();
            }
            IconSettings {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 1.0556rem;
                height: 1.0556rem;
                icon-color: Theme.dimmer;
            }
        }
    }
}
