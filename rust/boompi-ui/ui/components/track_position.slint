// Track progress bar with elapsed/remaining labels.
// Position interpolation happens in Rust (see main.rs); this just renders.

import { Theme } from "theme.slint";

export component TrackPosition inherits VerticalLayout {
    in property <float> progress; // 0.0-1.0
    in property <string> elapsed;
    in property <string> remaining;

    spacing: 0.2778rem;

    Rectangle {
        height: 0.3333rem;
        border-radius: 0.1667rem;
        background: Theme.faint;
        Rectangle {
            x: 0;
            y: 0;
            width: parent.width * min(1.0, max(0.0, root.progress));
            height: parent.height;
            border-radius: 0.1667rem;
            background: Theme.accent;
        }
    }

    HorizontalLayout {
        Rectangle {
            width: t1.preferred-width;
            height: t1.preferred-height;
            Text {
                x: 0.09rem;
                y: 0.09rem;
                text: root.elapsed;
                color: Theme.bg.transparentize(0.25);
                font-size: 0.7778rem;
            }
            t1 := Text {
                text: root.elapsed;
                color: Theme.dim;
                font-size: 0.7778rem;
            }
        }
        Rectangle { }
        Rectangle {
            width: t2.preferred-width;
            height: t2.preferred-height;
            Text {
                x: 0.09rem;
                y: 0.09rem;
                text: root.remaining;
                color: Theme.bg.transparentize(0.25);
                font-size: 0.7778rem;
            }
            t2 := Text {
                text: root.remaining;
                color: Theme.dim;
                font-size: 0.7778rem;
            }
        }
    }
}
