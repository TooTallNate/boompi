// Boompi UI root window. Resolution-adaptive: the linuxkms backend sizes
// the window to the panel (Pi 3 box: 800×480 HyperPixel; Pi 4 box:
// 1024×600 HDMI); layouts are percentage/layout-driven so both work.
// The preferred size below is the desktop-preview default (--size to
// override). Screens: main (connect / now-playing), battery, settings -
// with the visualizer behind everything and the footer always on top.

// Geist Sans (vendored, OFL - see fonts/OFL.txt) is embedded into the
// binary, so every platform renders identically with no OS font setup.
// Emoji fallback still comes from the system (fontconfig) - see
// docs/PLAN.md fonts section.
import "fonts/Geist.ttf";
import "fonts/Matrix-Code.ttf";

import { Theme } from "components/theme.slint";
// Re-export for Rust access (net.rs drives Theme.light from settings).
export { Theme }
import { Footer } from "components/footer.slint";
import { NowPlaying } from "components/now_playing.slint";
import { ConnectScreen } from "components/connect.slint";
import { BatteryPanel } from "components/battery_panel.slint";
import { GamesPanel, GameEntry } from "components/games_panel.slint";
import { SettingsPanel, EmojiFontRow } from "components/settings.slint";
import { Screensaver } from "components/screensaver.slint";

// One touch-feedback ripple (spawned from Rust's evdev reader).
export struct Ripple {
    x: float,
    y: float,
    born: float,
}
export { EmojiFontRow }
import { SetupScreen } from "components/setup.slint";
import { ActionButton } from "components/widgets.slint";

export component AppWindow inherits Window {
    title: "Boompi";
    preferred-width: 800px;
    preferred-height: 480px;
    background: Theme.bg;
    default-font-family: "Geist";
    // 18px design base; all lengths are rem, so this scales everything.
    default-font-size: 18px * Theme.scale;

    // --- connection / identity ---
    in property <bool> connected: false;
    in property <string> speaker-name: "boompi";
    in property <string> version-line: "";

    // --- source / track ---
    in property <string> device-name: "";
    in property <string> source-kind: "";
    in property <bool> has-track: false;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <bool> playing: false;
    in property <bool> controls-enabled: true;
    // Idle screensaver (driven from Rust: idle detection + low-fps tick).
    in-out property <bool> saver-active: false;
    in property <string> saver-kind: "clock";
    in property <int> saver-timeout-min: 10;
    in property <float> saver-tick: 0;
    callback saver-dismissed();
    // Transient toast message overlay.
    in-out property <bool> toast-on: false;
    in-out property <string> toast-text: "";
    // Low-battery warning banner (server-driven, hysteresis in boompid).
    in property <bool> battery-low: false;
    // Imminent self-poweroff notice (battery empty).
    in property <bool> poweroff-active: false;
    in property <string> poweroff-reason: "";
    // Touch-feedback ripples (positions in logical px; clock advances
    // ~30fps from Rust only while ripples are alive).
    in property <[Ripple]> ripples: [];
    in property <float> ripple-clock: 0;
    in property <float> progress: 0.0;
    in property <string> elapsed: "--:--";
    in property <string> remaining: "--:--";
    in-out property <float> volume: 0;
    // Raw analyzer frames from boompid (~30 fps). The Rust side tweens
    // these into `bars` and `peaks` at render rate; slint code should
    // only ever draw the tweened values.
    in-out property <[float]> bar-targets: [];
    in property <[float]> bars: [];
    // Peak-hold caps: the classic analyzer effect where a thin slice
    // lingers at the recent maximum, then falls with gravity, fading
    // towards transparent on the way down.
    in property <[float]> peaks: [];
    in property <[float]> peak-fades: [];
    in property <image> artwork;
    in property <bool> has-artwork: false;

    // --- games ---
    in property <[GameEntry]> games: [];
    in property <bool> games-gamepad: false;
    in property <string> game-running: "";
    callback game-launch(string, string);

    // --- battery ---
    in property <bool> battery-present: false;
    in property <string> battery-status: "unconfigured";
    in property <string> battery-status-detail: "";
    in property <float> battery-percentage: 0;
    in property <bool> battery-charging: false;
    in property <string> battery-voltage-path: "";
    in property <string> battery-current-path: "";
    in property <string> stat-volts: "-";
    in property <string> stat-amps: "-";
    in property <string> stat-watts: "-";
    in property <string> stat-percent: "-";
    in property <string> stat-time: "-";
    in property <bool> battery-full: false;

    // --- wifi ---
    in property <bool> wifi-supported: false;
    in property <string> wifi-connected: "";
    in property <string> wifi-ip: "";
    in-out property <bool> wifi-ap-active: false;
    in property <string> wifi-ap-ssid: "";
    in property <[string]> wifi-saved: [];
    callback wifi-rejoin(string);
    callback wifi-disconnect();
    callback wifi-ap-toggled(bool);

    // --- pairing / settings ---
    in property <string> pairing-state: "idle";
    in property <string> pairing-device: "";
    in property <string> pairing-passkey: "";
    in-out property <bool> online-art: false;
    in property <string> settings-url: "";
    in property <image> settings-qr;
    in property <[EmojiFontRow]> emoji-fonts: [];
    in property <string> airplay-model;
    in property <string> update-version;
    in property <string> update-status: "idle";
    in property <string> update-detail;
    in-out property <bool> update-channel-edge;
    in property <bool> setup-required: false;
    in property <string> setup-wifi-kind: "";
    in property <string> setup-wifi-text: "";

    // --- clock ---
    in property <string> clock-day: "";
    in property <string> clock-h: "";
    in property <string> clock-m: "";
    in property <string> clock-ampm: "";
    in property <bool> clock-24h: false;
    in property <bool> colon-on: true;

    // --- navigation ---
    in-out property <string> screen: "main"; // main | battery | settings

    callback toggle-play();
    callback next();
    callback previous();
    callback volume-edited(float);
    callback screen-changed();
    callback online-art-toggled(bool);
    callback theme-toggled(bool);
    callback scale-changed(float);
    callback emoji-font-tapped(string, string);
    callback airplay-model-tapped(string);
    callback saver-kind-tapped(string);
    callback saver-preview-tapped();
    callback clock-24h-toggled(bool);
    callback update-check();
    callback update-apply();
    callback update-channel-toggled(bool);
    callback pairing-enable();
    callback pairing-cancel();
    callback pairing-confirm();
    callback pairing-reject();

    // ---- art-tinted background gradient -------------------------------------
    Rectangle {
        background: @linear-gradient(170deg, Theme.bg-top 0%, Theme.bg-bottom 100%);
        animate background { duration: 700ms; easing: ease-out; }
    }

    // ---- background visualizer --------------------------------------------
    // Synthwave-ish: rounded bars with an accent→base vertical gradient
    // whose hot top stop reads as a neon glow. NB: no drop-shadows here -
    // a blur per bar per frame (and the blur area grows with bar height)
    // collapses the frame rate even on the Pi 4's GPU; the gradient fakes
    // the same look for free.
    HorizontalLayout {
        // Scale-invariant: the layout divides the screen into equal
        // slots (spacing 0 - any width-derived spacing binds through
        // the layout's own size negotiation and loops); each slot
        // carves its gap internally with width fractions.
        for level[bar-idx] in root.bars: Rectangle {
            Rectangle {
                x: parent.width * 0.09;
                width: parent.width * 0.82;
                y: parent.height - self.height;
                height: parent.height * level;
                border-radius: 0.1667rem;
                background: @linear-gradient(180deg,
                    Theme.accent.transparentize(0.05) 0%,
                    Theme.accent.transparentize(0.45) 14%,
                    Theme.bar 60%);
            }
            // Peak-hold cap: brightness alone sells the glow.
            if root.peaks[bar-idx] > 0.015: Rectangle {
                x: parent.width * 0.09;
                width: parent.width * 0.82;
                y: parent.height * (1 - root.peaks[bar-idx]) - self.height;
                height: 0.1667rem;
                border-radius: 0.0833rem;
                opacity: root.peak-fades[bar-idx];
                background: Theme.accent.transparentize(0.05);
            }
        }
    }

    // ---- main screen -------------------------------------------------------
    if !root.connected: VerticalLayout {
        alignment: center;
        Text {
            text: "Connecting to backend…";
            color: Theme.dimmer;
            font-size: 1.2222rem;
            horizontal-alignment: center;
        }
    }

    // First-boot onboarding covers the main screen until completed.
    if root.connected && root.setup-required && root.screen == "main": SetupScreen {
        speaker-name: root.speaker-name;
        settings-url: root.settings-url;
        settings-qr: root.settings-qr;
        wifi-status-kind: root.setup-wifi-kind;
        wifi-status-text: root.setup-wifi-text;
    }

    if root.connected && !root.setup-required && root.screen == "main" && !root.has-track: ConnectScreen {
        speaker-name: root.speaker-name;
        pairing-state: root.pairing-state;
        pairing-enable => {
            root.pairing-enable();
        }
        pairing-cancel => {
            root.pairing-cancel();
        }
    }

    if root.connected && !root.setup-required && root.screen == "main" && root.has-track: NowPlaying {
        track-title: root.track-title;
        track-artist: root.track-artist;
        track-album: root.track-album;
        artwork: root.artwork;
        has-artwork: root.has-artwork;
        playing: root.playing;
        controls-enabled: root.controls-enabled;
        disabled-tapped => {
            root.toast-text = "Control playback from the sending device";
            root.toast-on = true;
        }
        progress: root.progress;
        elapsed: root.elapsed;
        remaining: root.remaining;
        volume <=> root.volume;
        toggle-play => {
            root.toggle-play();
        }
        next => {
            root.next();
        }
        previous => {
            root.previous();
        }
        volume-edited(level) => {
            root.volume-edited(level);
        }
    }

    // ---- overlay screens ----------------------------------------------------
    if root.screen == "games": GamesPanel {
        games: root.games;
        gamepad: root.games-gamepad;
        running: root.game-running;
        launch(system, file) => {
            root.game-launch(system, file);
        }
        close => {
            root.screen = "main";
            root.screen-changed();
        }
    }

    if root.screen == "battery": BatteryPanel {
        present: root.battery-present;
        status: root.battery-status;
        status-detail: root.battery-status-detail;
        voltage-path: root.battery-voltage-path;
        current-path: root.battery-current-path;
        stat-volts: root.stat-volts;
        stat-amps: root.stat-amps;
        stat-watts: root.stat-watts;
        stat-percent: root.stat-percent;
        stat-time: root.stat-time;
        charging: root.battery-charging;
        full: root.battery-full;
        close => {
            root.screen = "main";
            root.screen-changed();
        }
    }

    if root.screen == "settings": SettingsPanel {
        speaker-name: root.speaker-name;
        version-line: root.version-line;
        emoji-fonts: root.emoji-fonts;
        airplay-model: root.airplay-model;
        airplay-model-tapped(value) => {
            root.airplay-model-tapped(value);
        }
        saver-kind: root.saver-kind;
        saver-kind-tapped(value) => {
            root.saver-kind-tapped(value);
        }
        saver-preview-tapped => {
            root.saver-preview-tapped();
        }
        clock-24h: root.clock-24h;
        clock-24h-toggled(v) => {
            root.clock-24h-toggled(v);
        }
        update-version: root.update-version;
        update-status: root.update-status;
        update-detail: root.update-detail;
        update-channel-edge <=> root.update-channel-edge;
        update-check => {
            root.update-check();
        }
        update-apply => {
            root.update-apply();
        }
        update-channel-toggled(edge) => {
            root.update-channel-toggled(edge);
        }
        emoji-font-tapped(id, status) => {
            root.emoji-font-tapped(id, status);
        }
        online-art <=> root.online-art;
        pairing-state: root.pairing-state;
        settings-url: root.settings-url;
        settings-qr: root.settings-qr;
        wifi-supported: root.wifi-supported;
        wifi-connected: root.wifi-connected;
        wifi-ip: root.wifi-ip;
        wifi-ap-active <=> root.wifi-ap-active;
        wifi-ap-ssid: root.wifi-ap-ssid;
        wifi-saved: root.wifi-saved;
        wifi-rejoin(ssid) => {
            root.wifi-rejoin(ssid);
        }
        wifi-disconnect => {
            root.wifi-disconnect();
        }
        wifi-ap-toggled(enabled) => {
            root.wifi-ap-toggled(enabled);
        }
        close => {
            root.screen = "main";
            root.screen-changed();
        }
        online-art-toggled(enabled) => {
            root.online-art-toggled(enabled);
        }
        scale-changed(scale) => {
            // Apply locally right away (snappy feedback); boompid's
            // Settings broadcast confirms the clamped value moments
            // later (idempotent).
            Theme.scale = scale;
            root.scale-changed(scale);
        }
        theme-toggled(light) => {
            root.theme-toggled(light);
        }
        pairing-enable => {
            root.pairing-enable();
        }
        pairing-cancel => {
            root.pairing-cancel();
        }
    }

    // ---- pairing confirmation (modal over everything) ------------------------
    // A passkey request must be answerable from any screen - settings,
    // now-playing, wherever. 30 s to respond before BlueZ times out.
    if root.pairing-state == "confirm": Rectangle {
        background: #000000aa;
        TouchArea { } // swallow touches behind the dialog
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 24.4444rem;
            height: 12.7778rem;
            background: Theme.panel;
            border-radius: 0.7778rem;
            border-width: 0.0556rem;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 1.2222rem;
                spacing: 0.3333rem;
                Text {
                    text: "Bluetooth pairing request";
                    color: Theme.dim;
                    font-size: 0.7778rem;
                }
                Text {
                    text: root.pairing-device == "" ? "Unknown device" : root.pairing-device;
                    color: Theme.fg;
                    font-size: 1.2222rem;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.pairing-passkey != "": Text {
                    text: "Confirm this code matches your device:";
                    color: Theme.dim;
                    font-size: 0.7778rem;
                }
                if root.pairing-passkey != "": Text {
                    text: root.pairing-passkey;
                    color: Theme.accent;
                    font-size: 1.6667rem;
                    horizontal-alignment: center;
                }
                if root.pairing-passkey == "": Text {
                    text: "wants to pair with this speaker.";
                    color: Theme.dim;
                    font-size: 0.8333rem;
                }
                Rectangle { height: 0.3333rem; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 0.6667rem;
                    ActionButton {
                        text: "Pair";
                        primary: true;
                        clicked => {
                            root.pairing-confirm();
                        }
                    }
                    ActionButton {
                        text: "Reject";
                        clicked => {
                            root.pairing-reject();
                        }
                    }
                }
            }
        }
    }

    // ---- gamepad autopair progress (no decision to make) ---------------------
    // Distinct from the confirm dialog above: autopair asks nothing, so
    // showing Pair/Reject buttons here just flashes an unanswerable
    // question. Dismissed by the server broadcasting a non-"pairing"
    // state when the pad is connected (or pairing failed).
    if root.pairing-state == "pairing": Rectangle {
        background: #000000aa;
        TouchArea { } // swallow touches behind the dialog
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 24.4444rem;
            height: 8.8889rem;
            background: Theme.panel;
            border-radius: 0.7778rem;
            border-width: 0.0556rem;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 1.2222rem;
                spacing: 0.3333rem;
                Text {
                    text: "Bluetooth pairing";
                    color: Theme.dim;
                    font-size: 0.7778rem;
                }
                Text {
                    text: root.pairing-device == "" ? "Unknown device" : root.pairing-device;
                    color: Theme.fg;
                    font-size: 1.2222rem;
                    font-weight: 600;
                    overflow: elide;
                }
                Text {
                    text: "Pairing\u{2026}";
                    color: Theme.dim;
                    font-size: 0.8333rem;
                }
            }
        }
    }

    // ---- footer (always on top) ---------------------------------------------
    Footer {
        x: 0;
        y: root.height - self.height;
        width: root.width;
        clock-day: root.clock-day;
        clock-h: root.clock-h;
        clock-m: root.clock-m;
        clock-ampm: root.clock-ampm;
        colon-on: root.colon-on;
        device-name: root.device-name;
        source-kind: root.source-kind;
        battery-present: root.battery-present;
        battery-percentage: root.battery-percentage;
        battery-charging: root.battery-charging;
        open-battery => {
            root.screen = root.screen == "battery" ? "main" : "battery";
            root.screen-changed();
        }
        open-games => {
            root.screen = root.screen == "games" ? "main" : "games";
            root.screen-changed();
        }
        open-settings => {
            root.screen = root.screen == "settings" ? "main" : "settings";
            root.screen-changed();
        }
    }

    // Low-battery banner: persistent while the warning is active,
    // above content, below the screensaver (waking the panel shows it;
    // boompid wakes the saver on the warning edge).
    if root.battery-low && !root.setup-required: Rectangle {
        x: (root.width - self.width) / 2;
        y: 0.6rem;
        width: low-label.preferred-width + 1.8rem;
        height: low-label.preferred-height + 0.9rem;
        background: #7a1f1fe0;
        border-radius: self.height / 2;
        border-width: 0.06rem;
        border-color: #ff5d5d80;
        low-label := Text {
            x: 0.9rem;
            y: 0.45rem;
            text: "Low battery — " + Math.round(root.battery-percentage * 100) + "% — plug in soon";
            color: #ffe3e3;
            font-size: 0.83rem;
        }
    }

    // Transient toast (e.g. tapping transport controls an AirPlay 2
    // sender doesn't allow). Auto-hides; sits above content, below the
    // screensaver.
    if root.toast-on: Rectangle {
        x: (root.width - self.width) / 2;
        y: root.height - Theme.footer-height-rem * 1rem - self.height - 1rem;
        width: toast-label.preferred-width + 1.8rem;
        height: toast-label.preferred-height + 1rem;
        background: #000000d8;
        border-radius: self.height / 2;
        border-width: 0.06rem;
        border-color: Theme.faint;
        toast-label := Text {
            x: 0.9rem;
            y: 0.5rem;
            text: root.toast-text;
            color: Theme.fg;
            font-size: 0.83rem;
        }
    }

    toast-timer := Timer {
        interval: 2.4s;
        running: root.toast-on;
        triggered => {
            root.toast-on = false;
        }
    }

    // Idle screensaver overlay - topmost, swallows the waking tap.
    // Never over the first-boot setup screen.
    if root.saver-active && !root.setup-required: Screensaver {
        width: root.width;
        height: root.height;
        kind: root.saver-kind;
        tick: root.saver-tick;
        clock-h: root.clock-h;
        clock-m: root.clock-m;
        clock-ampm: root.clock-ampm;
        clock-day: root.clock-day;
        artwork: root.artwork;
        has-artwork: root.has-artwork;
        track-title: root.track-title;
        battery-present: root.battery-present;
        battery-percentage: root.battery-percentage;
        battery-charging: root.battery-charging;
        dismissed => {
            root.saver-dismissed();
        }
    }

    // Imminent poweroff notice - covers everything (including the
    // screensaver): the box is about to turn itself off.
    if root.poweroff-active: Rectangle {
        width: root.width;
        height: root.height;
        background: #000000f0;
        VerticalLayout {
            alignment: center;
            spacing: 0.6rem;
            Text {
                text: "🪫";
                horizontal-alignment: center;
                font-size: 3.2rem;
            }
            Text {
                text: root.poweroff-reason;
                horizontal-alignment: center;
                font-size: 1.6rem;
                color: Theme.fg;
            }
            Text {
                text: "Shutting down — flip the power switch, then charge";
                horizontal-alignment: center;
                font-size: 0.95rem;
                color: Theme.dim;
            }
        }
    }

    // Touch ripples - topmost (feedback even over the screensaver),
    // never interactive. An expanding, fading ring like v1's
    // water-drop effect.
    for r in root.ripples: Rectangle {
        property <float> p: Math.min(1.0, Math.max(0.0, (root.ripple-clock - r.born) / 0.45));
        property <float> pe: 1 - (1 - self.p) * (1 - self.p); // ease-out
        x: r.x * 1px - self.width / 2;
        y: r.y * 1px - self.height / 2;
        width: (16 + 74 * self.pe) * 1px;
        height: self.width;
        border-radius: self.width / 2;
        border-width: 2px;
        border-color: #ffffff.transparentize(0.25 + 0.75 * self.p);
        background: #ffffff.transparentize(0.90 + 0.10 * self.p);
    }
}
