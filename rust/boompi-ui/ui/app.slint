// Boompi UI root window. Resolution-adaptive: the linuxkms backend sizes
// the window to the panel (Pi 3 box: 800×480 HyperPixel; Pi 4 box:
// 1024×600 HDMI); layouts are percentage/layout-driven so both work.
// The preferred size below is the desktop-preview default (--size to
// override). Screens: main (connect / now-playing), battery, settings -
// with the visualizer behind everything and the footer always on top.

// Geist Sans (vendored, OFL - see fonts/OFL.txt) is embedded into the
// binary, so every platform renders identically with no OS font setup.
// Emoji fallback still comes from the system (fontconfig) - see
// docs/PLAN.md fonts section.
import "fonts/Geist.ttf";

import { Theme } from "components/theme.slint";
// Re-export for Rust access (net.rs drives Theme.light from settings).
export { Theme }
import { Footer } from "components/footer.slint";
import { NowPlaying } from "components/now_playing.slint";
import { ConnectScreen } from "components/connect.slint";
import { BatteryPanel } from "components/battery_panel.slint";
import { SettingsPanel, EmojiFontRow } from "components/settings.slint";
export { EmojiFontRow }
import { SetupScreen } from "components/setup.slint";
import { ActionButton } from "components/widgets.slint";

export component AppWindow inherits Window {
    title: "Boompi";
    preferred-width: 800px;
    preferred-height: 480px;
    background: Theme.bg;
    default-font-family: "Geist";
    // 18px design base; all lengths are rem, so this scales everything.
    default-font-size: 18px * Theme.scale;

    // --- connection / identity ---
    in property <bool> connected: false;
    in property <string> speaker-name: "boompi";
    in property <string> version-line: "";

    // --- source / track ---
    in property <string> device-name: "";
    in property <string> source-kind: "";
    in property <bool> has-track: false;
    in property <string> track-title;
    in property <string> track-artist;
    in property <string> track-album;
    in property <bool> playing: false;
    in property <float> progress: 0.0;
    in property <string> elapsed: "--:--";
    in property <string> remaining: "--:--";
    in-out property <float> volume: 0;
    // Raw analyzer frames from boompid (~30 fps). The Rust side tweens
    // these into `bars` and `peaks` at render rate; slint code should
    // only ever draw the tweened values.
    in-out property <[float]> bar-targets: [];
    in property <[float]> bars: [];
    // Peak-hold caps: the classic analyzer effect where a thin slice
    // lingers at the recent maximum, then falls with gravity, fading
    // towards transparent on the way down.
    in property <[float]> peaks: [];
    in property <[float]> peak-fades: [];
    in property <image> artwork;
    in property <bool> has-artwork: false;

    // --- battery ---
    in property <bool> battery-present: false;
    in property <float> battery-percentage: 0;
    in property <bool> battery-charging: false;
    in property <string> battery-voltage-path: "";
    in property <string> battery-current-path: "";
    in property <string> stat-volts: "-";
    in property <string> stat-amps: "-";
    in property <string> stat-watts: "-";
    in property <string> stat-percent: "-";

    // --- pairing / settings ---
    in property <string> pairing-state: "idle";
    in property <string> pairing-device: "";
    in property <string> pairing-passkey: "";
    in-out property <bool> online-art: false;
    in property <string> settings-url: "";
    in property <image> settings-qr;
    in property <[EmojiFontRow]> emoji-fonts: [];
    in property <bool> setup-required: false;
    in property <string> setup-wifi-kind: "";
    in property <string> setup-wifi-text: "";

    // --- clock ---
    in property <string> clock-day: "";
    in property <string> clock-h: "";
    in property <string> clock-m: "";
    in property <bool> colon-on: true;

    // --- navigation ---
    in-out property <string> screen: "main"; // main | battery | settings

    callback toggle-play();
    callback next();
    callback previous();
    callback volume-edited(float);
    callback screen-changed();
    callback online-art-toggled(bool);
    callback theme-toggled(bool);
    callback scale-changed(float);
    callback emoji-font-tapped(string, string);
    callback pairing-enable();
    callback pairing-cancel();
    callback pairing-confirm();
    callback pairing-reject();

    // ---- art-tinted background gradient -------------------------------------
    Rectangle {
        background: @linear-gradient(170deg, Theme.bg-top 0%, Theme.bg-bottom 100%);
        animate background { duration: 700ms; easing: ease-out; }
    }

    // ---- background visualizer --------------------------------------------
    // Synthwave-ish: rounded bars with an accent→base vertical gradient
    // whose hot top stop reads as a neon glow. NB: no drop-shadows here -
    // a blur per bar per frame (and the blur area grows with bar height)
    // collapses the frame rate even on the Pi 4's GPU; the gradient fakes
    // the same look for free.
    HorizontalLayout {
        // Scale-invariant: the layout divides the screen into equal
        // slots (spacing 0 - any width-derived spacing binds through
        // the layout's own size negotiation and loops); each slot
        // carves its gap internally with width fractions.
        for level[bar-idx] in root.bars: Rectangle {
            Rectangle {
                x: parent.width * 0.09;
                width: parent.width * 0.82;
                y: parent.height - self.height;
                height: parent.height * level;
                border-radius: 0.1667rem;
                background: @linear-gradient(180deg,
                    Theme.accent.transparentize(0.05) 0%,
                    Theme.accent.transparentize(0.45) 14%,
                    Theme.bar 60%);
            }
            // Peak-hold cap: brightness alone sells the glow.
            if root.peaks[bar-idx] > 0.015: Rectangle {
                x: parent.width * 0.09;
                width: parent.width * 0.82;
                y: parent.height * (1 - root.peaks[bar-idx]) - self.height;
                height: 0.1667rem;
                border-radius: 0.0833rem;
                opacity: root.peak-fades[bar-idx];
                background: Theme.accent.transparentize(0.05);
            }
        }
    }

    // ---- main screen -------------------------------------------------------
    if !root.connected: VerticalLayout {
        alignment: center;
        Text {
            text: "Connecting to backend…";
            color: Theme.dimmer;
            font-size: 1.2222rem;
            horizontal-alignment: center;
        }
    }

    // First-boot onboarding covers the main screen until completed.
    if root.connected && root.setup-required && root.screen == "main": SetupScreen {
        speaker-name: root.speaker-name;
        settings-url: root.settings-url;
        settings-qr: root.settings-qr;
        wifi-status-kind: root.setup-wifi-kind;
        wifi-status-text: root.setup-wifi-text;
    }

    if root.connected && !root.setup-required && root.screen == "main" && !root.has-track: ConnectScreen {
        speaker-name: root.speaker-name;
        pairing-state: root.pairing-state;
        pairing-enable => {
            root.pairing-enable();
        }
        pairing-cancel => {
            root.pairing-cancel();
        }
    }

    if root.connected && !root.setup-required && root.screen == "main" && root.has-track: NowPlaying {
        track-title: root.track-title;
        track-artist: root.track-artist;
        track-album: root.track-album;
        artwork: root.artwork;
        has-artwork: root.has-artwork;
        playing: root.playing;
        progress: root.progress;
        elapsed: root.elapsed;
        remaining: root.remaining;
        volume <=> root.volume;
        toggle-play => {
            root.toggle-play();
        }
        next => {
            root.next();
        }
        previous => {
            root.previous();
        }
        volume-edited(level) => {
            root.volume-edited(level);
        }
    }

    // ---- overlay screens ----------------------------------------------------
    if root.screen == "battery": BatteryPanel {
        voltage-path: root.battery-voltage-path;
        current-path: root.battery-current-path;
        stat-volts: root.stat-volts;
        stat-amps: root.stat-amps;
        stat-watts: root.stat-watts;
        stat-percent: root.stat-percent;
        charging: root.battery-charging;
        close => {
            root.screen = "main";
            root.screen-changed();
        }
    }

    if root.screen == "settings": SettingsPanel {
        speaker-name: root.speaker-name;
        version-line: root.version-line;
        emoji-fonts: root.emoji-fonts;
        emoji-font-tapped(id, status) => {
            root.emoji-font-tapped(id, status);
        }
        online-art <=> root.online-art;
        pairing-state: root.pairing-state;
        settings-url: root.settings-url;
        settings-qr: root.settings-qr;
        close => {
            root.screen = "main";
            root.screen-changed();
        }
        online-art-toggled(enabled) => {
            root.online-art-toggled(enabled);
        }
        scale-changed(scale) => {
            // Apply locally right away (snappy feedback); boompid's
            // Settings broadcast confirms the clamped value moments
            // later (idempotent).
            Theme.scale = scale;
            root.scale-changed(scale);
        }
        theme-toggled(light) => {
            root.theme-toggled(light);
        }
        pairing-enable => {
            root.pairing-enable();
        }
        pairing-cancel => {
            root.pairing-cancel();
        }
    }

    // ---- pairing confirmation (modal over everything) ------------------------
    // A passkey request must be answerable from any screen - settings,
    // now-playing, wherever. 30 s to respond before BlueZ times out.
    if root.pairing-state == "confirm": Rectangle {
        background: #000000aa;
        TouchArea { } // swallow touches behind the dialog
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 24.4444rem;
            height: 12.7778rem;
            background: Theme.panel;
            border-radius: 0.7778rem;
            border-width: 0.0556rem;
            border-color: Theme.accent;
            VerticalLayout {
                padding: 1.2222rem;
                spacing: 0.3333rem;
                Text {
                    text: "Bluetooth pairing request";
                    color: Theme.dim;
                    font-size: 0.7778rem;
                }
                Text {
                    text: root.pairing-device == "" ? "Unknown device" : root.pairing-device;
                    color: Theme.fg;
                    font-size: 1.2222rem;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.pairing-passkey != "": Text {
                    text: "Confirm this code matches your device:";
                    color: Theme.dim;
                    font-size: 0.7778rem;
                }
                if root.pairing-passkey != "": Text {
                    text: root.pairing-passkey;
                    color: Theme.accent;
                    font-size: 1.6667rem;
                    horizontal-alignment: center;
                }
                if root.pairing-passkey == "": Text {
                    text: "wants to pair with this speaker.";
                    color: Theme.dim;
                    font-size: 0.8333rem;
                }
                Rectangle { height: 0.3333rem; }
                HorizontalLayout {
                    alignment: center;
                    spacing: 0.6667rem;
                    ActionButton {
                        text: "Pair";
                        primary: true;
                        clicked => {
                            root.pairing-confirm();
                        }
                    }
                    ActionButton {
                        text: "Reject";
                        clicked => {
                            root.pairing-reject();
                        }
                    }
                }
            }
        }
    }

    // ---- footer (always on top) ---------------------------------------------
    Footer {
        x: 0;
        y: root.height - self.height;
        width: root.width;
        clock-day: root.clock-day;
        clock-h: root.clock-h;
        clock-m: root.clock-m;
        colon-on: root.colon-on;
        device-name: root.device-name;
        source-kind: root.source-kind;
        battery-present: root.battery-present;
        battery-percentage: root.battery-percentage;
        battery-charging: root.battery-charging;
        open-battery => {
            root.screen = root.screen == "battery" ? "main" : "battery";
            root.screen-changed();
        }
        open-settings => {
            root.screen = root.screen == "settings" ? "main" : "settings";
            root.screen-changed();
        }
    }
}
